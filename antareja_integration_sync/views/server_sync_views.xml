<odoo>
    <data>
        <record id="external_server_sync_form" model="ir.ui.view">
            <field name="name">external.server.sync.form</field>
            <field name="model">external.server.sync</field>
            <field name="inherit_id" ref="amr_data_sync.external_server_sync_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='page_info']" position="attributes">
                    <attribute name="attrs">{'invisible': [('external_mode', '!=', 'standard')]}</attribute>
                </xpath>
                <field name="name" position="after">
                    <field name="external_mode"/>
                </field>
                <field name="app_name" position="after">
                    <field name="application_server_auth_id" attrs="{'invisible': [('external_mode', '!=', 'server_auth')]}" />
                    <field name="application_server_path_id" attrs="{'invisible': [('external_mode', '!=', 'server_path')]}" />
                </field>
                <xpath expr="//field[@name='app_name']" position="attributes">
                    <attribute name="attrs">{'invisible': [('external_mode', '=', 'standard')]}</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
