<odoo>
    <record id="view_config_settings_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="antareja_base.view_config_settings_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='antareja_mobile_token_description']" position="after">
                <div class="mt16 row">
                    <label for="antareja_mobile_token_expires_in" class="col-3 col-lg-3 o_light_label"/>
                    <field name="antareja_mobile_token_expires_in" nolabel="1"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
