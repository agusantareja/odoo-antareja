<odoo>
    <record id="view_config_settings_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form</field>
        <field name="model">res.config.settings</field>

        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@class='settings']//div[@id='emails']" position="after">
                <field name="module_queue_job" invisible="1" />
                <div id="mail_template_internal" attrs="{'invisible':[('module_queue_job','=',False)]}">
                    <h2>Generate Message Email,Whatsapp and Bot Approval</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <div class="content-group">
                                    <div class="mt16 row">
                                        <label for="using_queue_for_send_message" string="Using Queue"
                                               class="col-3 col-lg-3 o_light_label"/>
                                        <field name="using_queue_for_send_message" class="oe_inline"
                                               required="1"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
