        <record id="remove_sales_section" model="ir.ui.view">
            <field name="name">metalindo.vendor.remove.sales.section.from.partner.form</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="metalindo_vendor.view_partner_form_inherit"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='sale']" position="berfore">
                    <field name="is_supplier" invisible="1"/>
                </xpath>
                <xpath expr="//group[@name='sale']" position="attributes">
                    <attribute name="attrs">{'invisible': [('is_supplier', '=', False)]}</attribute>
