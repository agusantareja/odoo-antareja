<odoo>
    <data >

        <record id="cron_sync_from_snipeit_hardware" model="ir.cron">
            <field name="name">Sync Snipe-IT Hardware</field>
            <field name="model_id" ref="model_snipe_hardware"/>
            <field name="state">code</field>
            <field name="code">model.cron_sync_from_snipeit_hardware()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="nextcall" eval="(DateTime.now() - timedelta(hours=8)).strftime('%Y-%m-%d %H:05:00')" />
            <field name="active">True</field>
        </record>
        <record id="cron_sync_from_snipeit_image" model="ir.cron">
            <field name="name">Sync Snipe-IT Image</field>
            <field name="model_id" ref="model_snipe_image"/>
            <field name="state">code</field>
            <field name="code">model.cron_download()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
