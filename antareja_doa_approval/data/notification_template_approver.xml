<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="mir_approver_mail_template" model="mail.template">
            <field name="name">Material Requsition Approver</field>
            <field name="model_id" ref="cni_inventory_intra.model_material_requisition"/>
            <field name="subject">Material Requisition: ${object.name | safe}</field>
            <field name="body_html" type="html">
                <table style="
    padding-top:16px;background-color: #f1f1f1;
    font-family: Verdana, Arial, sans-serif;
    color: #454748;
    width: 100%;
    border-collapse: separate;
  " cellspacing="0" cellpadding="0" border="0">
                    <tbody>
                        <tr>
                            <td align="center">
                                <table style="
            background-color:white;color: #454748;
            border-collapse: separate;
          " width="590" cellspacing="0" cellpadding="0" border="0">
                                    <tbody>
                                        <!-- HEADER -->
                                        <tr>
                                            <td style="min-width:590px" align="center">
                                                <table style="
                    min-width:590px;background-color: white;
                    padding: 0px 8px 0px 8px;
                    border-collapse: separate;
                  " width="590" cellspacing="0" cellpadding="0" border="0">
                                                    <tbody>
                                                        <tr>
                                                            <td valign="middle">
                                                                <!-- <span style="font-size:10px;">Dear</span>
                                                                                                <span style="font-size:10px;font-weight: bold;">
                                                                                                    ${object.name}
                                                                                                </span> -->
                                                            </td>
                                                            <td style="text-align:right" valign="middle">
                                                                <table class="table"
                                                                       style="margin-top:16px;margin-bottom: 0;"
                                                                       width="100%">
                                                                    <tbody>
                                                                        <tr>
                                                                            <td style="width:50%;text-align: left">
                                                                                % if object.company_id.name == 'PT.
                                                                                CERIA NUGRAHA INDOTAMA':
                                                                                <img class="img-fluid o_we_custom_image"
                                                                                     src="/cni_inventory_intra/static/src/img/logo.png"
                                                                                     style="
                                          color:rgb(69, 71, 72);font-family: Lucida Grande, Helvetica,
                                          Verdana, Arial, sans-serif;
                                          text-align: left;
                                          width: 143.5px;
                                        "/>
                                                                                % else:
                                                                                <img class="img-fluid o_we_custom_image"
                                                                                     src="/cni_inventory_intra/static/src/img/logo_cmp.png"
                                                                                     style="
                                          color:rgb(69, 71, 72);font-family: Lucida Grande, Helvetica,
                                          Verdana, Arial, sans-serif;
                                          text-align: left;
                                          width: 143.5px;
                                        "/>
                                                                                % endif
                                                                                <br/>
                                                                            </td>
                                                                            <td style="text-align:right;width: 50%">
                                                                                <b>
                                                                                    <font style="font-size:10px">
                                                                                        INTRANET
                                                                                    </font>
                                                                                    <br/>
                                                                                    % if object.company_id.name == 'PT.
                                                                                    CERIA NUGRAHA INDOTAMA':
                                                                                    <font style="font-size:10px">PT
                                                                                        CERIA NUGRAHA INDOTAMA
                                                                                    </font>
                                                                                    % else:
                                                                                    <font style="font-size:10px">PT
                                                                                        CERIA METALINDO PRIMA
                                                                                    </font>
                                                                                    % endif
                                                                                </b>
                                                                            </td>
                                                                        </tr>
                                                                    </tbody>
                                                                </table>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td colspan="2" style="text-align:center">
                                                                <hr style="
                            background-color:rgb(204, 204, 204);border: medium none;
                            clear: both;
                            display: block;
                            font-size: 0px;
                            min-height: 1px;
                            line-height: 0;
                            margin: 16px 0px 16px 0px;
                          " width="100%"/>
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </td>
                                        </tr>
                                        <!-- CONTENT -->
                                        <tr>
                                            <td style="min-width:590px" align="center">
                                                <div style="text-align:left">
                                                    <div style="text-align:center">
                                                        <span style="
                        font-style:inherit;font-variant-ligatures: inherit;
                        font-variant-caps: inherit;
                        font-weight: inherit;
                      ">Material Requsition dengan kode:
                                                        </span>
                                                    </div>
                                                    <div style="text-align:center">
                                                        <span style="
                        font-style:inherit;font-variant-ligatures: inherit;
                        font-variant-caps: inherit;
                      ">
                                                            <b>
                                                                <font style="font-size:24px">${object.name | safe}
                                                                </font>
                                                            </b>
                                                        </span>
                                                        <br/>
                                                        <span>Dari ${object.request_by.name}</span>
                                                        <br/>
                                                        <br/>
                                                        <span style="
                        font-style:inherit;font-variant-ligatures: inherit;
                        font-variant-caps: inherit;
                        font-weight: inherit;
                      ">butuh approval anda sebagai
                                                        </span>
                                                        <span style="
                        font-style:inherit;font-variant-ligatures: inherit;
                        font-variant-caps: inherit;
                      ">
                                                            <b>Approver</b>
                                                        </span>
                                                        <br/>
                                                        <br/>
                                                        % if object.url:
                                                        <a href="${object.url}" style="cursor:pointer">
                                                            <table style="width:auto;margin: 0 auto" class="table">
                                                                <tbody>
                                                                    <tr>
                                                                        <td class="bg-alpha"
                                                                            style="background-color:#00a09d;padding: 8px">
                                                                            <b>
                                                                                <font style="color:rgb(247, 247, 247)">
                                                                                    Lihat&#160;
                                                                                </font>
                                                                            </b>
                                                                            <font color="#f7f7f7">
                                                                                <b>${object.name}</b>
                                                                            </font>
                                                                        </td>
                                                                    </tr>
                                                                </tbody>
                                                            </table>
                                                        </a>
                                                        % else:
                                                        <a href="https://intra.cerindocorp.id" style="cursor:pointer">
                                                            <table style="width:auto;margin: 0 auto" class="table">
                                                                <tbody>
                                                                    <tr>
                                                                        <td class="bg-alpha"
                                                                            style="background-color:#00a09d;padding: 8px">
                                                                            <b>
                                                                                <font style="color:rgb(247, 247, 247)">
                                                                                    Lihat&#160;
                                                                                </font>
                                                                            </b>
                                                                            <font color="#f7f7f7">
                                                                                <b>${object.name}</b>
                                                                            </font>
                                                                        </td>
                                                                    </tr>
                                                                </tbody>
                                                            </table>
                                                        </a>
                                                        % endif
                                                    </div>
                                                </div>
                                                <table style="
                    min-width:590px;background-color: white;
                    padding: 0px 8px 0px 8px;
                    border-collapse: separate;
                  " width="590" cellspacing="0" cellpadding="0" border="0">
                                                    <tbody>
                                                        <tr>
                                                            <!-- <td valign="top" style="font-size:13px;"> -->

                                                            <!-- </td> -->
                                                        </tr>
                                                        <!-- <tr t-foreach="object.order_line" t-as="line">
                                                                                        <td>
                                                                                            <span t-esc="line.product_id.name"></span>
                                                                                        </td>
                                                                                    </tr> -->
                                                        <tr>
                                                            <td style="text-align:center">
                                                                <hr style="
                            background-color:rgb(204, 204, 204);border: medium none;
                            clear: both;
                            display: block;
                            font-size: 0px;
                            min-height: 1px;
                            line-height: 0;
                            margin: 16px 0px 16px 0px;
                          " width="100%"/>
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </td>
                                        </tr>
                                        <!-- FOOTER -->
                                        <tr>
                                            <td style="min-width:590px;" align="center">
                                                <table style="min-width:590px;background-color: white; font-size: 11px; padding: 0px 8px 0px 8px; border-collapse:separate;"
                                                       width="590" cellspacing="0" cellpadding="0" border="0">
                                                    <tbody>
                                                        <tr>
                                                            <td style="text-align:left;" valign="middle">
                                                                ${object.company_id.name}
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </td>
                        </tr>
                    </tbody>
                </table>

            </field>
        </record>

        <record id="mir_approver_wa_template" model="mail.template">
            <field name="name">Approver WA Notification</field>
            <field name="model_id" ref="cni_inventory_intra.model_material_requisition"/>
            <field name="subject">${object.name}</field>
            <field name="body_html"><![CDATA[Hai ${ctx.get('notification_to_user').name} Material Requisition Dengan Kode ${object.name} dari ${object.request_by.name} dari department ${object.department_id.name} butuh approval anda sebagai Approver ${object.url | safe} ]]></field>
        </record>

        <record id="mir_approver_mobile_template" model="notification.mobile.template">
            <field name="name">Approver Mobile Notification</field>
            <field name="model_id" ref="cni_inventory_intra.model_material_requisition"/>
            <field name="title">Approval ${object.name}</field>
            <field name="body"><![CDATA[Hai ${ctx.get('notification_to_user').name} Material Requisition Dengan Kode ${object.name} dari ${object.request_by.name} dari department ${object.department_id.name} butuh approval anda sebagai Approver ${object.url | safe} ]]></field>
<!--            <field name="image">Todo send url image</field>-->
            <field name="code">
originator = record.request_by or user
data.update(
    url=record.get_internal_url(),
    source_number=record.name,
    source_document=record.get_internal_description(),
    source_originator_name=originator.name
)
            </field>
        </record>

        <record id="mir_approver_notification_template" model="notification.template">
            <field name="name">Approver Notification</field>
            <field name="model">material.inventory.request</field>
            <field name="template_email" ref="mir_approver_mail_template" />
            <field name="template_wa" ref="mir_approver_wa_template" />
            <field name="template_mobile" ref="mir_approver_mobile_template" />
        </record>
    </data>
</odoo>