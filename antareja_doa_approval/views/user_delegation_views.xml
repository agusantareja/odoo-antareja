<odoo>
    <record id="view_user_delegation_form" model="ir.ui.view">
        <field name="name">user.delegation</field>
        <field name="model">user.delegation</field>
        <field name="priority" eval="16"/>
        <field name="inherit_id" ref="antareja_doa.view_user_delegation_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='state']" position="attributes">
                <attribute name="statusbar_visible">draft,waiting_approval,approved,active</attribute>
            </xpath>
            <xpath expr="//header" position="inside">
                <field name="access_approval" invisible="1"/>
                <button name="action_approve"
                        string="Approve"
                        type="object" class="oe_highlight"
                        attrs="{'invisible': [('access_approval','=',False)]}"
                />
                <button name="action_reject"
                        string="Reject"
                        type="object" class="oe_highlight"
                        attrs="{'invisible': ['|',('access_approval','=',False),('state', '=', 'draft')]}"
                />
            </xpath>
            <notebook position="inside">
                <page string="Approval">
                    <field name="approval_task_line" readonly="1" />
                </page>
            </notebook>
        </field>

    </record>

    <record id="action_to_approve_user_delegation" model="ir.actions.act_window">
        <field name="name">To Approve</field>
        <field name="res_model">user.delegation</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('state','=','waiting_approval'),('access_approval', '=', True)]</field>
    </record>
</odoo>
