<odoo>
    <record id="view_config_settings_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="antareja_base.view_config_settings_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='antareja_integration_enabled_setting']" position="inside">
                <div class="col-xs-12 col-md-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="module_antareja_integration_sync"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <div class="content-group">
                            <label for="module_antareja_integration_sync"/>
                            <div class="text-muted" id="antareja_integration_sync_description">
                                Application Integration Sync
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-md-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="module_antareja_integration_app_intra_cerindocorp"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <div class="content-group">
                            <label for="module_antareja_integration_app_intra_cerindocorp"/>
                            <div class="text-muted" id="module_antareja_integration_app_intra_cerindocorp">
                                Application Integration to Intra
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-md-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="module_antareja_integration_app_erp_cerindocorp"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <div class="content-group">
                            <label for="module_antareja_integration_app_erp_cerindocorp"/>
                            <div class="text-muted" id="module_antareja_integration_app_erp_cerindocorp">
                                Application Integration to ERP
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-md-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="module_antareja_integration_app_hr_cerindocorp"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <div class="content-group">
                            <label for="module_antareja_integration_app_hr_cerindocorp"/>
                            <div class="text-muted" id="module_antareja_integration_app_hr_cerindocorp">
                                Application Integration to HR
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-md-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="module_antareja_integration_app_payroll_cerindocorp"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <div class="content-group">
                            <label for="module_antareja_integration_app_payroll_cerindocorp"/>
                            <div class="text-muted" id="module_antareja_integration_app_payroll_cerindocorp">
                                Application Integration to Payroll
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
