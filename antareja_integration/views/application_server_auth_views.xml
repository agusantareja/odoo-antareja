<odoo>

    <record id="view_application_server_auth_form" model="ir.ui.view">
        <field name="name">application.server.auth.form</field>
        <field name="model">application.server.auth</field>
        <field name="inherit_id" ref="antareja_base.view_application_server_auth_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='page_path']" position="after">
                <page string="JWT ODOO RCP" attrs="{'invisible':[('auth_type','!=','jwt-odoo-rcp')]}">
                    <group>
                        <group string="JWT Token">
                            <field name="rest_token"/>
                            <field name="rest_refresh"/>
                        </group>
                        <group string="Get Token">
                            <field name="username"/>
                            <button string="Get Token" type="object" name="action_open_token_wizard"/>
                        </group>
                    </group>
                </page>
            </xpath>
            <field name="odoo_server_db" position="after">
                <button string="Get db name" type="object" name="action_get_odoo_db_name"
                        class="oe_stat_button" icon="fa-refresh"
                />
            </field>
            <field name="odoo_server_uid" position="after">
                <button string="Get UID" type="object"
                        name="action_get_odoo_server_uid"
                        class="oe_stat_button" icon="fa-refresh"
                />
            </field>
            <field name="password" position="after">
                <button string="Test" type="object" name="action_test_connection"/>
            </field>
        </field>
    </record>

    <!-- Action -->
    <record id="action_application_server_auth" model="ir.actions.act_window">
        <field name="name">Application Server Auth</field>
        <field name="res_model">application.server.auth</field>
        <field name="view_mode">tree,form</field>

        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Application Server Auth here.
            </p>
        </field>
    </record>

</odoo>
