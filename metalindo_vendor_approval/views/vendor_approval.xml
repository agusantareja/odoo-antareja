				<notebook position="inside">
					<page string="Approval" attrs="{'invisible': [('supplier_rank', '=', 0)]}">
						<field name="approval_ids" readonly="1">
							<tree string="Approval">
								<field name="currency_id" invisible="1" />
								<field name="group_id" />
								<field name="sts" />
								<field name="reason" />
								<field name="pelaksana_id" />
								<field name="tanggal" />
							</tree>
							<form string="Approval">
								<group>
									<group>
										<field name="group_id" />
										<field name="sts" />
										<field name="reason" />
									</group>
									<group>
										<field name="pelaksana_id" />
										<field name="tanggal" />
									</group>
								</group>
							</form>
						</field>
					</page>
					<page
						name="change_page"
						string="Change Request"
						attrs="{'invisible': [('change_reason', '=', False)]}"
					>
						<group>
							<field name="request_change_by" readonly="1"/>
							<field name="request_change_date" readonly="1"/>
							<field
								name="change_reason"
								attrs="{
									'readonly': [
										'|',
										('state', '!=', 'draft'),
										('approval_type', '!=', 'change')
									]
								}"
							/>
						</group>
					</page>
					<page
						name="blacklist_page"
						string="Blacklist Request"
						attrs="{'invisible': [('blacklist_reason', '=', False)]}"
					>
						<group>
							<field name="request_blacklist_by" readonly="1"/>
							<field name="request_blacklist_date" readonly="1"/>
							<field name="blacklist_reason" readonly="1"/>
						</group>
					</page>
					<page
						name="whitelist_page"
						string="Whitelist Request"
						attrs="{'invisible': [('whitelist_reason', '=', False)]}"
					>
						<group>
							<field name="request_whitelist_by" readonly="1"/>
							<field name="request_whitelist_date" readonly="1"/>
							<field name="whitelist_reason" readonly="1"/>
						</group>
					</page>
				</notebook>

			</field>
