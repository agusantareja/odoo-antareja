<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
		<record id="view_partner_form_inherit" model="ir.ui.view">
			<field name="name">vendor approval</field>
			<field name="model">res.partner</field>
			<field name="inherit_id" ref="metalindo_vendor.view_partner_form_inherit"/>
			<field name="arch" type="xml">
				<sheet position="before">
					<header>
						<field name="supplier_readonly" invisible="1"/>
						<field name="approval_type" invisible="1"/>
						<field name="is_approver" invisible="1"/>
						<field name="supplier_rank" invisible="1"/>
						<div
							class="h-100 d-flex align-items-center justify-content-center me-2"
							attrs="{'invisible': ['|', ('supplier_rank', '=', 0),('approval_type', '=', False)]}"
						>
							<field name="approval_type_label" readonly="1" class="mb-0"/>
						</div>

						<button
							string="Request Approval"
							name="button_request_approval"
							type="object"
							class="oe_highlight"
							attrs="{'invisible': ['|', '|', '|', ('supplier_rank', '=', 0), ('active', '=', False), ('state', '!=', 'draft'), ('is_company', '=', False)]}"
						/>
						<button
							string="Request Change"
							name="button_request_change"
							type="object"
							attrs="{'invisible': ['|', '|', '|', ('supplier_rank', '=', 0), ('active', '=', False), ('is_company', '=', False), ('state', '!=', 'approved')]}"
						/>
						<button
							string="Request Blacklist"
							name="button_request_blacklist"
							type="object"
							attrs="{'invisible': ['|', '|', '|', ('supplier_rank', '=', 0), ('active', '=', False), ('is_company', '=', False), ('state', '!=', 'approved')]}"
						/>
						<button
							string="Request Whitelist"
							name="button_request_whitelist"
							type="object"
							attrs="{'invisible': ['|', '|', '|', ('supplier_rank', '=', 0), ('active', '=', False), ('is_company', '=', False), ('state', '!=', 'blacklisted')]}"
						/>

						<button
							string="Approve"
							name="button_approve_approval"
							type="object"
							class="oe_highlight"
							attrs="{'invisible': ['|', '|', '|', '|', ('supplier_rank', '=', 0), ('active', '=', False), ('state', '!=', 'waiting'), ('is_approver', '=', False), ('is_company', '=', False)]}"
						/>
						<!--
							State transition after final rejection is handled by the `metalindo_approval`
							module directly, unlike approval, hence we have to provide separate reject
							buttons for different `approval_type`s.
						-->
						<!-- Reject button for vendor registration (approval_type == 'registration') -->
						<button
							string="Reject"
							name="reject_approval_wizard_action"
							type="object"
							attrs="{
								'invisible': [
									'|',
									'|',
									'|',
									'|', 
									'|', 
									('supplier_rank', '=', 0),
									('active', '=', False),
									('is_company', '=', False),
									('state', '!=', 'waiting'),
									('approval_type', '!=', 'registration'),
									('is_approver', '=', False)
								]
							}"
						/>
						<!-- Reject button for vendor change (approval_type == 'change') -->
						<button
							string="Reject"
							name="%(metalindo_approval.cni_reject_approval_wizard_action)d"
							type="action"
							context="{'model_name': 'res.partner', 'update_value': {'state': 'draft'}}"
							attrs="{
								'invisible': [
									'|',
									'|',
									'|',
									'|',
									'|', 
									('supplier_rank', '=', 0),
									('active', '=', False),
									('is_company', '=', False),
									('state', '!=', 'waiting'),
									('approval_type', '!=', 'change'),
									('is_approver', '=', False)
								]
							}"
						/>
						<!-- Reject button for vendor blacklist (approval_type == 'blacklist') -->
						<button
							string="Reject"
							name="%(metalindo_approval.cni_reject_approval_wizard_action)d"
							type="action"
							context="{
								'model_name': 'res.partner',
								'update_value': {
									'state': 'approved',
									'approval_type': False
								}
							}"
							attrs="{
								'invisible': [
									'|',
									'|',
									'|',
									'|',
									'|', 
									('supplier_rank', '=', 0),
									('active', '=', False),
									('is_company', '=', False),
									('state', '!=', 'waiting'),
									('approval_type', '!=', 'blacklist'),
									('is_approver', '=', False)
								]
							}"
						/>
						<!-- Reject button for vendor whitelist (approval_type == 'whitelist') -->
						<button
							string="Reject"
							name="%(metalindo_approval.cni_reject_approval_wizard_action)d"
							type="action"
							context="{
								'model_name': 'res.partner',
								'update_value': {
									'state': 'blacklisted',
									'approval_type': False
								}
							}"
							attrs="{
								'invisible': [
									'|',
									'|',
									'|',
									'|',
									'|', 
									('supplier_rank', '=', 0),
									('active', '=', False),
									('is_company', '=', False),
									('state', '!=', 'waiting'),
									('approval_type', '!=', 'whitelist'),
									('is_approver', '=', False)
								]
							}"
						/>
						<!-- We'll remove this button for now to avoid having the vendor approval stuck at 'waiting' -->
						<!-- <button
							string="Cancel Approval"
							name="button_cancel"
							type="object"
							groups="group_metalindo_vendor_approval"
							attrs="{'invisible': ['|', '|', ('active', '=', False), ('state', '!=', 'approved'), ('is_company', '=', False)]}"
						/> -->
						<!-- We'll remove this button for now since its usefulness is questionable -->
						<!-- <button
							string="Cancel Rejection"
							name="button_cancel"
							type="object"
							groups="group_metalindo_vendor_approval"
							attrs="{'invisible': ['|', '|', ('active', '=', False), ('state', '!=', 'reject'), ('is_company', '=', False)]}"
						/> -->

						<field
							name="state"
							widget="statusbar"
							readonly="1"
							statusbar_visible="draft,waiting,approved,blacklisted"
							attrs="{'invisible': [('supplier_rank', '=', 0)]}"
						/>
					</header>
					<field name="flag_reject" invisible="1" />
					<div class="alert alert-info" role="alert" attrs="{'invisible': ['|', ('state', '!=', 'waiting'), ('flag_reject', '=', True)]}">
						<table width="100%">
							<tr>
								<td width="98%">
									<field name="alert_waiting_approval" readonly="1" />
								</td>
								<td>
									<a class="close" data-bs-dismiss="alert" href="#">x</a>
								</td>
							</tr>
						</table>
					</div>
					<div class="alert alert-danger" role="alert" attrs="{'invisible': [('flag_reject', '=', False)]}">
						<table width="100%">
						<tr>
							<td width="98%">
								<field name="note_reject" readonly="1" />
							</td>
							<td>
								<a class="close" data-bs-dismiss="alert" href="#">x</a>
							</td>
						</tr>
						</table>
					</div>
				</sheet>

				<xpath expr="//widget[@name='web_ribbon']" position="after">
					<widget name="web_ribbon" title="Blacklist" bg_color="bg-dark" attrs="{'invisible': ['|', ('active', '=', False), ('state', '!=', 'blacklist')]}"/>
					<widget name="web_ribbon" title="Reject" bg_color="bg-warning" attrs="{'invisible': ['|', ('active', '=', False), ('state', '!=', 'reject')]}"/>
				</xpath>

				<xpath expr="//field[@name='name'][@id='company']" position="attributes">
					<attribute  name="attrs" remove="}" add=", 'readonly': [('state', '!=', 'draft')]}" separator="]"/>
				</xpath>
				<xpath expr="//field[@name='company_type']" position="attributes">
					<attribute name="attrs">
						{
							'readonly': [
								'|', ('state', '!=', 'draft'), ('approval_type', '=', 'change')
							]
						}
					</attribute>
				</xpath>
