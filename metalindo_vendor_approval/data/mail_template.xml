<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="vendor_approval_mail_template" model="mail.template">
            <field name="name">Vendor Approval</field>
            <field name="model_id" ref="metalindo_vendor_approval.model_res_partner" />
            <field name="subject">Vendor Approval: {{ object.name }}</field>
            <field name="body_html" type="html">
                <table
                    style="padding-top:16px;background-color: #F1F1F1; font-family:Verdana, Arial,sans-serif; color: #454748; width: 100%; border-collapse:separate;"
                    cellspacing="0" cellpadding="0" border="0">
                    <tbody>
                        <tr>
                            <td align="center">
                                <table
                                    style="padding:16px;background-color: white; color: #454748; border-collapse:separate;"
                                    width="590" cellspacing="0" cellpadding="0" border="0">
                                    <tbody>
                                        <!-- HEADER -->
                                        <tr>
                                            <td style="min-width:590px;" align="center">
                                                <table
                                                    style="min-width:590px;background-color: white; padding: 0px 8px 0px 8px; border-collapse:separate;"
                                                    width="590" cellspacing="0" cellpadding="0" border="0">
                                                    <tbody>
                                                        <tr>
                                                            <td valign="middle">
                                                                <!-- <span style="font-size:10px;">Dear</span>
                                                                <span style="font-size:10px;font-weight: bold;">
                                                                    ${object.name}
                                                                </span> -->
                                                            </td>
                                                            <td style="text-align:right;" valign="middle">
                                                                <img t-attf-src="/logo.png?company={{ object.company_id.id }}"
                                                                    style="padding:0px;margin: 0px; height: auto; width: 80px;"
                                                                    t-att-alt="object.company_id.name" />
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td colspan="2" style="text-align:center;">
                                                                <hr style="background-color:rgb(204,204,204);border:medium none;clear:both;display:block;font-size:0px;min-height:1px;line-height:0; margin: 16px 0px 16px 0px;"
                                                                    width="100%" />
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </td>
                                        </tr>
                                        <!-- CONTENT -->
                                        <tr>
                                            <td style="min-width:590px;" align="center">
                                                <div>
                                                    <div style="text-align:left;">
                                                        Vendor berikut membutuhkan approval anda
                                                        <br/>
                                                        Vendor : <t t-out="object.name or ''" />
                                                        <br/>
                                                        Mohon periksa pengajuan melalui link dibawah. 
                                                        <br/>
                                                        Terima kasih
                                                        <br/>
                                                        <i>Pesan ini adalah pesan otomatis dari sistem ERP CMP</i>
                                                    </div>
                                                    <div style="margin:16px 0px 16px 0px;">
                                                        <a t-att-href="object.vendor_link"
                                                            style="background-color:#875A7B;padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;">
                                                            View Vendor Approval
                                                        </a>
                                                    </div>
                                                </div>
                                                <table
                                                    style="min-width:590px;background-color: white; padding: 0px 8px 0px 8px; border-collapse:separate;"
                                                    width="590" cellspacing="0" cellpadding="0" border="0">
                                                    <tbody>
                                                        <tr>
                                                        </tr>
                                                        <tr>
                                                            <td style="text-align:center;">
                                                                <hr style="background-color:rgb(204,204,204);border:medium none;clear:both;display:block;font-size:0px;min-height:1px;line-height:0; margin: 16px 0px 16px 0px;"
                                                                    width="100%"/>
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </td>
                                        </tr>
                                        <!-- FOOTER -->
                                        <tr>
                                            <td style="min-width:590px;" align="center">
                                                <table
                                                    style="min-width:590px;background-color: white; font-size: 11px; padding: 0px 8px 0px 8px; border-collapse:separate;"
                                                    width="590" cellspacing="0" cellpadding="0" border="0">
                                                    <tbody>
                                                        <tr>
                                                            <td style="text-align:left;" valign="middle">
                                                                <t t-out="object.company_id.name or ''"/>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td style="opacity:0.7;text-align: left;" valign="middle">
                                                                <t t-out="object.company_id.phone or ''">+1 650-123-4567</t>
                                                                <t t-if="object.company_id.email">
                                                                    | <a t-attf-href="'mailto:%s' % {{ object.company_id.email }}" style="text-decoration:none; color: #454748;"><t t-out="object.company_id.email or ''">info@yourcompany.com</t></a>
                                                                </t>
                                                                <t t-if="object.company_id.website">
                                                                    | <a t-attf-href="'%s' % {{ object.company_id.website }}" style="text-decoration:none; color: #454748;">
                                                                        <t t-out="object.company_id.website or ''">http://www.example.com</t>
                                                                    </a>
                                                                </t>
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </td>
                        </tr>
                    </tbody>
                </table>

            </field>
        </record>
    </data>
</odoo>