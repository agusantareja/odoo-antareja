<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit res.config.settings view -->
    <record id="res_config_settings_view_form_inherit_cni_api" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.cni.api</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="priority">71</field>
        <field name="arch" type="xml">
            <xpath expr="//div[@class='settings']//div[@id='emails']" position="after">
                <div id="antareja_notification_mobile_client">
                    <h2>Mobile Notification Client</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="col-xs-12 col-md-6 o_setting_box" >
                                    <div class="o_setting_left_pane">
                                        <field name="module_antareja_notification_ceria_mobile_local"/>
                                    </div>
                                    <div class="o_setting_right_pane" id="partner_autocomplete_settings">
                                        <label for="module_antareja_notification_ceria_mobile_local"/>
                                        <div class="text-muted">
                                            Local Implmentation Notification Ceria Mobile
                                        </div>
                                    </div>
                                </div>
                            <div class="o_setting_right_pane">
                                <div class="content-group">
                                    <div class="mt16 row">
                                        <label for="mobile_notification_application_name" string="Application" class="col-3 col-lg-3 o_light_label"/>
                                        <field name="mobile_notification_application_name" nolabel="1"/>
                                    </div>
                                    <div id="mobile_notification_endpoint" class="mt16 row" >
                                        <label for="mobile_notification_endpoint" string="Endpoint" class="col-3 col-lg-3 o_light_label"/>
                                        <field name="mobile_notification_endpoint" placeholder="Endpoint" nolabel="1"/>
                                    </div>
                                    <div id="mobile_notification_token" class="mt16 row" >
                                        <label for="mobile_notification_token" string="Token" class="col-3 col-lg-3 o_light_label"/>
                                        <field name="mobile_notification_token"  placeholder="Token" nolabel="1"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
