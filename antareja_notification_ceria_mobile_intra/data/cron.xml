<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.cron" id="mobile_notification_client_cron">
        <field name="name">Mobile Notification Client Cron</field>
        <field name="model_id" ref="model_mobile_notification_client"/>
        <field name="state">code</field>
        <field name="code">model.cron_send()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="nextcall" eval="DateTime.now().strftime('%Y-%m-%d %H:05:00')"/>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>

</odoo>
