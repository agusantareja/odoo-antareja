<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="whatsapp_api_end_point" model="whatsapp.api">
            <field name="name">Whatsapp API (Send Message)</field>
            <field name="endpoint">url</field>
            <field name="header">{"X-API-Token":"Token here"}</field>
        </record>

        <record id="whatsapp_api_end_point_param_phone" model="whatsapp.api.param">
            <field name="name">phone</field>
            <field name="api_id" ref="whatsapp_api_end_point"/>
        </record>

        <record id="whatsapp_api_end_point_param_message" model="whatsapp.api.param">
            <field name="name">message</field>
            <field name="api_id" ref="whatsapp_api_end_point"/>
        </record>

        <record id="whatsapp_api_end_point_param_ref" model="whatsapp.api.param">
            <field name="name">ref</field>
            <field name="api_id" ref="whatsapp_api_end_point"/>
        </record>

        <record id="whatsapp_api_end_point_param_scope" model="whatsapp.api.param">
            <field name="name">scope</field>
            <field name="api_id" ref="whatsapp_api_end_point"/>
        </record>
    </data>
</odoo>
