<odoo>
    <record id="view_account_move_form" model="ir.ui.view">
        <field name="name">account.move</field>
        <field name="model">account.move</field>
        <field name="priority" eval="16"/>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
<!--            <xpath expr="//header/field[@name='state']" position="attributes">-->
<!--                <attribute name="statusbar_visible">draft,waiting_approval,approved,active</attribute>-->
<!--            </xpath>-->
            <xpath expr="//header" position="inside">
                <field name="access_approval" invisible="1"/>
                <field name="move_need_approval"  />
                <field name="state_is_draft" />
                <button name="action_request_approval"
                        string="Request Approval"
                        type="object" class="oe_highlight"
                        attrs="{'invisible': ['|',('state_is_draft','=',False),('move_need_approval','=',False)]}"
                />
                <button name="action_approve_transaction"
                        string="Approve"
                        type="object" class="oe_highlight"
                        attrs="{'invisible': [('access_approval','=',False)]}"
                />
                <button name="action_reject_transaction"
                        string="Reject"
                        type="object" class="oe_highlight"
                        attrs="{'invisible': ['|',('access_approval','=',False),('state', '=', 'draft')]}"
                />
                <button name="strategy_button_submit"
                        string="Strategy Button Submit" type="object" class="oe_highlight" groups="base.group_no_one"
                        attrs="{'invisible': [('move_need_approval','=',False)]}"
                />
                <button name="setup_approval_stage"
                        string="Setup Approval Stages" type="object" class="oe_highlight" groups="base.group_no_one"
                        attrs="{'invisible': [('move_need_approval','=',False)]}"
                />
                <button name="check_next_approval_task"
                        string="Check Next Approval Task" type="object" class="oe_highlight" groups="base.group_no_one"
                        attrs="{'invisible': [('move_need_approval','=',False)]}"
                />
                <field name="approval_state" widget="statusbar" statusbar_visible="draft,posted"
                    attrs="{'invisible': [('move_need_approval','=',False)]}"
                />
            </xpath>
<!--            <xpath expr="//field[@name='end_date']" position="after">-->
<!--                <field name="request_date" readonly="1"/>-->
<!--            </xpath>-->
            <xpath expr="//form//sheet" position="inside">
                <notebook id="approval_form" attrs="{'invisible': [('move_need_approval','=',False)]}">
                    <page name="approval_config" string="Approval Config">
                        <field name="approval_stage_active" readonly="1"/>
                        <field name="approval_stage_task_active" readonly="1"/>
                    </page>
                    <page string="Approval Task" >
                        <group>
                            <group>
                                <field name="approval_instance_id" readonly="1" context="{'create':False,'edit':False}"/>
                                <field name="approval_stage_id" readonly="1" context="{'create':False,'edit':False}"/>
                                <field name="next_approval_task_ref" readonly="1" context="{'create':False,'edit':False}"/>
                            </group>
                        </group>
                        <field name="approval_stage_task_line" readonly="1" />
                    </page>
                    <page string="Audit Trail">
                        <field name="approval_audit_log_line" readonly="1" />
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>
