<odoo>
    <record id="view_invoice_tree" model="ir.ui.view">
        <field name="name">account.move</field>
        <field name="model">account.move</field>
        <field name="priority" eval="16"/>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="approval_state" widget="badge"
                       decoration-info="approval_state == 'waiting_approval'"
                       decoration-success="approval_state == 'approved'"
                       decoration-danger="approval_state == 'rejected'"
                       attrs="{'invisible': [('approval_state', 'in', ('draft'))]}" optional="hide"
                />
            </field>

        </field>
    </record>

    <record id="view_account_move_form" model="ir.ui.view">
        <field name="name">account.move</field>
        <field name="model">account.move</field>
        <field name="priority" eval="20"/>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='state']" position="attributes">
                <attribute name="attrs">{'invisible': [('move_need_approval','=',True)]}</attribute>
            </xpath>

            <xpath expr="//header" position="inside">
                <field name="move_readonly" invisible="1"/>
                <field name="access_approval" invisible="1"/>
                <field name="move_need_approval"  invisible="1"/>
<!--                <field name="state_is_draft" invisible="1"/>-->
                <field name="approval_state" invisible="1"/>
                <button name="action_request_approval"
                        string="Request Approval"
                        type="object" class="oe_highlight"
                        attrs="{'invisible': ['|',('approval_state','!=','draft'),('move_need_approval','=',False)]}"
                />
                <button name="action_approve"
                        string="Approve"
                        type="object" class="oe_highlight"
                        attrs="{'invisible': ['|',('access_approval','=',False),('approval_state', '=', 'draft')]}"
                />
                <button name="action_reject"
                        string="Reject"
                        type="object" class="oe_highlight"
                        attrs="{'invisible': ['|',('access_approval','=',False),('approval_state', '=', 'draft')]}"
                />
<!--                <field name="approval_state" widget="statusbar" statusbar_visible="draft,waiting_approval,posted"-->
<!--                    attrs="{'invisible': [('move_need_approval','=',False)]}"-->
<!--                />-->

            </xpath>
            <xpath expr="//group[@id='header_right_group']//field[@name='journal_id']" position="attributes">
                <attribute name="attrs">{'readonly': ['|',('posted_before', '=', True),('move_readonly','=',True)]}</attribute>
            </xpath>
            <notebook  position="inside" >
                <page string="Approval" attrs="{'invisible': [('move_need_approval','=',False)]}">
                    <field name="cni_approval_line" readonly="1"/>
                </page>
            </notebook>
        </field>
    </record>

</odoo>
