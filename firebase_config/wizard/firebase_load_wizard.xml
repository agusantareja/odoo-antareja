<odoo>
    <record id="view_firebase_load_wizard" model="ir.ui.view">
        <field name="name">firebase.load.wizard</field>
        <field name="model">firebase.load.wizard</field>
        <field name="arch" type="xml">
            <form string="Load JSON File">
                <group>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                </group>
                <footer>
                    <button string="Load" name="action_load" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_firebase_load_file" model="ir.actions.act_window">
        <field name="name">Load JSON File</field>
        <field name="res_model">firebase.load.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
