<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.cron" id="report_generate_store_cron">
        <field name="name">Generate Report and Store Cron</field>
        <field name="model_id" ref="model_report_store"/>
        <field name="state">code</field>
        <field name="code">model.cron_render_report()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">20</field>
        <field name="interval_type">minutes</field>
        <field name="nextcall" eval="DateTime.now().strftime('%Y-%m-%d %H:05:00')"/>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>
</odoo>
