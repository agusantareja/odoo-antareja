<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="view_report_download_wizard" model="ir.ui.view">
        <field name="name">report.download.wizard.form</field>
        <field name="model">report.download.wizard</field>
        <field name="arch" type="xml">
            <form string="Report">
                <group>
                    <field name="file" readonly="1" filename="filename"/>
                    <field name="filename" invisible="1"/>
                </group>
                <footer>
                    <button special="cancel" string="Close" class="oe_highlight"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
