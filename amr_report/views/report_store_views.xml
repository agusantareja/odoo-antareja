<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_report_store_tree" model="ir.ui.view">
        <field name="name">report.store.tree</field>
        <field name="model">report.store</field>
        <field name="arch" type="xml">
            <tree string="Report Store"
                  default_order="create_date desc"
                  decoration-success="state == 'done'"
                  decoration-danger="state == 'error'"
                  decoration-warning="state == 'processing'"
            >
                <field name="name"/>
                <field name="user_id"/>
                <field name="state"/>
                <field name="executor"/>
                <field name="last_call"/>
                <field name="next_call"/>
            </tree>
        </field>
    </record>

    <record id="view_report_store_form" model="ir.ui.view">
        <field name="name">report.store.form</field>
        <field name="model">report.store</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <form string="Report Store">
                <header>
                    <button name="action_generate_report"
                            type="object"
                            string="Generate"
                            class="btn-primary"
                            attrs="{'invisible': [('state', '=', 'done')]}"
                    />
                    <button name="action_send_email"
                            type="object"
                            string="Send Email"
                            class="btn-primary"
                            attrs="{'invisible': [('send_email_report', '=', False)]}"
                    />
                    <button name="action_next_action"
                            type="object"
                            string="Next Action"
                            class="btn-primary"
                            attrs="{'invisible': [('next_action', '=', False)]}"
                    />

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="prepare,processing,done,error"
                    />
                    <field name="attachment_id" invisible="1"/>
                    <field name="filename"  invisible="1"/>
                    <field name="send_email_report"  invisible="1"/>
                    <field name="next_action"  invisible="1"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="file" widget="binary" filename="filename" />
                            <field name="start_render" readonly="1" groups="base.group_no_one"/>
                            <field name="generated_at" readonly="1"/>
                        </group>
                        <group>
                            <field name="user_id" readonly="1"/>
                            <field name="recipient_ids" widget="many2many_tags" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook groups="base.group_no_one">
                        <page string="Error"
                              attrs="{'invisible': [('state', '!=', 'error')]}">
                            <group>
                                <field name="error_message" readonly="1"/>
                                <field name="error_trace" readonly="1"/>
                            </group>
                        </page>
                        <page string="Config">
                            <group>
                                <field name="last_call" readonly="1"/>
                                <field name="next_call" readonly="1"/>
                                <field name="executor" readonly="1"/>
                            </group>
                        </page>
                        <page string="Parameter">
                            <field name="parameter_json" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_report_form_download" model="ir.ui.view">
        <field name="name">report.download.mixin.form</field>
        <field name="model">report.download.mixin</field>
        <field name="arch" type="xml">
            <form string="Download">
                <sheet>
                    <group>
                        <group>
                            <field name="filename" invisible="1" />
                            <field name="file" widget="binary" filename="filename" />
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button special="cancel" string="Close" class="oe_highlight"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_report_store" model="ir.actions.act_window">
        <field name="name">Report Store</field>
        <field name="res_model">report.store</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_report_store_root"
              name="Reports"
              sequence="10"/>

    <menuitem id="menu_report_store"
              name="Generated Report Store"
              parent="menu_report_store_root"
              action="action_report_store"
              sequence="10"/>
</odoo>
