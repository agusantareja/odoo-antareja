<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data noupdate="1">

    <record model="ir.module.category" id="module_category_purchase_revision">
      <field name="name">Purchase Revision</field>
      <field name="description">Purchase Revision</field>
      <field name="sequence">20</field>
    </record> 

    <record model="ir.module.category" id="module_category_purchase_revision_group">
      <field name="name">Purchase Revision Group</field>
      <field name="description">Purchase Revision Group</field>
      <field name="sequence">10</field>
      <field name="parent_id" ref="module_category_purchase_revision" />
    </record> 

    <record id="group_purchase_revision_requester" model="res.groups">
      <field name="name">Purchase Revision Requester</field>
      <field name="category_id" ref="module_category_purchase_revision_group"/>
      <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Automatically add procurement engineers to Purchase Revision Requester group -->
    <record id="metalindo_inventory.group_metalindo_procurement_engineer" model="res.groups">
      <field name="implied_ids" eval="[(4, ref('group_purchase_revision_requester'))]"/>
    </record>

    <record id="group_purchase_revision_approver" model="res.groups">
      <field name="name">Purchase Revision Approver</field>
      <field name="category_id" ref="module_category_purchase_revision_group"/>
      <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
      <field name="implied_ids" eval="[(4, ref('group_purchase_revision_requester'))]"/>
    </record>

  </data>
</odoo>
