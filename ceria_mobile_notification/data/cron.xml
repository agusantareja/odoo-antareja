<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.cron" id="ceria_mobile_notification_cron">
        <field name="name">Mobile Notification Cron</field>
        <field name="model_id" ref="model_ceria_mobile_notification" />
        <field name="state">code</field>
        <field name="code">model.cron_send()</field>
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="nextcall" eval="DateTime.now().strftime('%Y-%m-%d %H:05:00')" />
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>
</odoo>
