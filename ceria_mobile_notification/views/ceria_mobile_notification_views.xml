<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_ceria_mobile_notification_search" model="ir.ui.view">
            <field name="name">ceria.mobile.notification.search</field>
            <field name="model">ceria.mobile.notification</field>
            <field name="arch" type="xml">
                <search>
                    <field name="title"/>
                    <field name="body"/>
                    <field name="to_user_id"/>
                    <group>
                        <filter name="filter_source_model" string="Source Model" context="{'group_by':'source_model'}"/>
                        <filter name="filter_user" string="User" context="{'group_by':'to_user_id'}"/>
                    </group>
                </search>
            </field>
        </record>

		<record id="view_ceria_mobile_notification_tree" model="ir.ui.view">
            <field name="name">ceria.mobile.notification.tree</field>
            <field name="model">ceria.mobile.notification</field>
            <field name="arch" type="xml">
                <tree string="Mobile Notification Log" create='false' edit='false' decoration-muted="state in ('done', 'cancel')" decoration-info="state=='ready_to_send'" decoration-danger="state in ('error', 'send_error')">
                    <field name="title"/>
                    <field name="notification_type"/>
                    <field name="to_user_id"/>
                    <field name="source_application"/>
                    <field name="source_model"/>
                    <field name="source_res_id"/>
                    <field name="state" />
                    <button name="send" string="Send Now" type="object" icon="fa-paper-plane text-success" states="ready_to_send"/>
                    <button name="mark_outgoing" string="Retry" type="object" icon="fa-repeat text-success" states="error,send_error,cancel"/>
                    <button name="cancel" string="Cancel" type="object" icon="fa-times-circle text-danger" states="ready_to_send"/>
                </tree>
            </field>
        </record>

        <record id="view_ceria_mobile_notification_form" model="ir.ui.view">
            <field name="name">ceria.mobile.notification.form</field>
            <field name="model">ceria.mobile.notification</field>
            <field name="arch" type="xml">
                <form string="Mobile Notification Log" create='false' delete='false'>
                    <header>
                        <button name="event_update_approval" string="Update Approval" type="object" />
                        <button name="send" string="Send Now" type="object" icon="fa-paper-plane text-success" states="ready_to_send"/>
                        <button name="mark_outgoing" string="Retry" type="object" icon="fa-repeat text-success" states="error,send_error,cancel"/>
                        <button name="cancel" string="Cancel" type="object" icon="fa-times-circle text-danger" states="ready_to_send"/>
                        <button name="process" string="Process" type="object" />
                        <field name="state" widget="statusbar" readonly="1" />
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="to_user_id"/>
                                <field name="title"/>
                                <field name="image"/>
                                <field name="notification_type"/>
                            </group>
                            <group>
                                <field name="source_application"/>
                                <field name="source_model"/>
                                <field name="source_res_id"/>
                                <field name="mobile_approval_id" />
                            </group>
                        </group>
                        <notebook>
                            <page name="body" string="Body">
                                <field name="body"/>
                            </page>
                            <page name="raw_data" string="Raw Data">
                                <field name="accept_data"/>
                            </page>
                            <page name="audit_log" string="Audit Log">
                                <group>
                                    <group>
                                        <field name="errors_message"/>
                                    </group>
                                    <group>
                                        <field name="last_error"/>
                                    </group>
                                </group>
                            </page>
                            <page name="send_payload" string="Send Payload">
                                <field name="payload"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="ceria_mobile_notification_action" model="ir.actions.act_window">
            <field name="name">Mobile Notification</field>
            <field name="res_model">ceria.mobile.notification</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_ceria_mobile_notification_search"/>
            <!-- <field name="domain">[('api_type', '=', 'normal_api')]</field> -->
            <field name="context">{ }</field>
        </record>
    </data>
</odoo>