<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="vendor_approval_mail_template" model="mail.template">
            <field name="name">Vendor Approval</field>
            <field name="model_id" ref="base.model_res_partner" />
            <field name="subject">Vendor Approval: {{ object.name }}</field>
            <field name="partner_to">{{ object.notification_to_user_id.partner_id.id}}</field>
            <field name="lang">{{ object.notification_to_user_id.partner_id.lang }}</field>
            <field name="body_html" type="html">
                <table
                    style="padding-top:16px;background-color: #F1F1F1; font-family:Verdana, Arial,sans-serif; color: #454748; width: 100%; border-collapse:separate;"
                    cellspacing="0" cellpadding="0" border="0">
                    <tbody>
                        <tr>
                            <td align="center">
                                <table
                                    style="padding:16px;background-color: white; color: #454748; border-collapse:separate;"
                                    width="590" cellspacing="0" cellpadding="0" border="0">
                                    <tbody>
                                        <!-- HEADER -->
                                        <tr>
                                            <td style="min-width:590px;" align="center">
                                                <table
                                                    style="min-width:590px;background-color: white; padding: 0px 8px 0px 8px; border-collapse:separate;"
                                                    width="590" cellspacing="0" cellpadding="0" border="0">
                                                    <tbody>
                                                        <tr>
                                                            <td valign="middle">
                                                                <!-- <span style="font-size:10px;">Dear</span>
                                                                <span style="font-size:10px;font-weight: bold;">
                                                                    ${object.name}
                                                                </span> -->
                                                            </td>
                                                            <td style="text-align:right;" valign="middle">
                                                                <img t-attf-src="/logo.png?company={{ object.company_id.id }}"
                                                                    style="padding:0px;margin: 0px; height: auto; width: 80px;"
                                                                    t-att-alt="object.company_id.name" />
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td colspan="2" style="text-align:center;">
                                                                <hr style="background-color:rgb(204,204,204);border:medium none;clear:both;display:block;font-size:0px;min-height:1px;line-height:0; margin: 16px 0px 16px 0px;"
                                                                    width="100%" />
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </td>
                                        </tr>
                                        <!-- CONTENT -->
                                        <tr>
                                            <td style="min-width:590px;" align="center">
                                                <div>
                                                    <div style="text-align:left;">
                                                        Vendor berikut membutuhkan approval anda
                                                        <br/>
                                                        Vendor : <t t-out="object.name or ''" />
                                                        <br/>
                                                        Mohon periksa pengajuan melalui link dibawah.
                                                        <br/>
                                                        Terima kasih
                                                        <br/>
                                                        <i>Pesan ini adalah pesan otomatis dari sistem ERP CMP</i>
                                                    </div>
                                                    <div style="margin:16px 0px 16px 0px;">
                                                        <a t-att-href="object.vendor_link"
                                                            style="background-color:#875A7B;padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;">
                                                            View Vendor Approval
                                                        </a>
                                                    </div>
                                                </div>
                                                <table
                                                    style="min-width:590px;background-color: white; padding: 0px 8px 0px 8px; border-collapse:separate;"
                                                    width="590" cellspacing="0" cellpadding="0" border="0">
                                                    <tbody>
                                                        <tr>
                                                        </tr>
                                                        <tr>
                                                            <td style="text-align:center;">
                                                                <hr style="background-color:rgb(204,204,204);border:medium none;clear:both;display:block;font-size:0px;min-height:1px;line-height:0; margin: 16px 0px 16px 0px;"
                                                                    width="100%"/>
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </td>
                                        </tr>
                                        <!-- FOOTER -->
                                        <tr>
                                            <td style="min-width:590px;" align="center">
                                                <table
                                                    style="min-width:590px;background-color: white; font-size: 11px; padding: 0px 8px 0px 8px; border-collapse:separate;"
                                                    width="590" cellspacing="0" cellpadding="0" border="0">
                                                    <tbody>
                                                        <tr>
                                                            <td style="text-align:left;" valign="middle">
                                                                <t t-out="object.company_id.name or ''"/>
                                                            </td>
                                                        </tr>
                                                        <tr>
                                                            <td style="opacity:0.7;text-align: left;" valign="middle">
                                                                <t t-out="object.company_id.phone or ''">+1 650-123-4567</t>
                                                                <t t-if="object.company_id.email">
                                                                    | <a t-attf-href="'mailto:%s' % {{ object.company_id.email }}" style="text-decoration:none; color: #454748;"><t t-out="object.company_id.email or ''">info@yourcompany.com</t></a>
                                                                </t>
                                                                <t t-if="object.company_id.website">
                                                                    | <a t-attf-href="'%s' % {{ object.company_id.website }}" style="text-decoration:none; color: #454748;">
                                                                        <t t-out="object.company_id.website or ''">http://www.example.com</t>
                                                                    </a>
                                                                </t>
                                                            </td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </td>
                        </tr>
                    </tbody>
                </table>

            </field>
        </record>

        <record id="mail_template_chat_notification_approval_task" model="mail.template">
            <field name="name">Odoo Bot Chat Notification Approval Task</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="subject">Odoo Bot Chat Notification Approval Task</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Hi <t t-out="object.notification_to_user_id.partner_id.name or ''"/> ,
                        <t t-out="object.name or ''"/>  Vendor butuh approval anda. Terima kasih
                        <br/>
                        <a t-att-href="object.vendor_link">Klik disini untuk melihat detail</a>
                    </p>
                </div>
            </field>
        </record>

        <record id="whatsapp_template_notification_approval_task" model="whatsapp.template">
            <field name="name">cmp_metalindo_vendor_approval.whatsapp_template_notification_approval_task</field>
            <field name="recipient">object.notification_to_user_id.partner_id</field>
            <field name="model_id" ref="base.model_res_partner"/>
        </record>
        <record id="whatsapp_template_notification_approval_task_param_phone" model="whatsapp.template.param">
            <field name="key">phone</field>
            <field name="type">record</field>
            <field name="value">phone</field>
            <field name="template_id" ref="cmp_metalindo_vendor_approval.whatsapp_template_notification_approval_task"/>
        </record>
        <record id="whatsapp_template_notification_approval_task_param_ref" model="whatsapp.template.param">
            <field name="key">ref</field>
            <field name="type">record</field>
            <field name="value">object.name</field>
            <field name="template_id" ref="cmp_metalindo_vendor_approval.whatsapp_template_notification_approval_task"/>
        </record>
        <record id="whatsapp_template_notification_approval_task_param_scope" model="whatsapp.template.param">
            <field name="key">scope</field>
            <field name="type">fix</field>
            <field name="value">APPROVAL</field>
            <field name="template_id" ref="cmp_metalindo_vendor_approval.whatsapp_template_notification_approval_task"/>
        </record>

        <record id="whatsapp_template_notification_approval_task_param_message" model="whatsapp.template.param">
            <field name="key">message</field>
            <field name="type">record</field>
            <field name="value">Hi ${partner.name}, ${object.name} Vendor butuh approval anda. Terima kasih
Klik disini untuk melihat detail
${object.vendor_link}</field>
            <field name="template_id" ref="cmp_metalindo_vendor_approval.whatsapp_template_notification_approval_task"/>
        </record>

        <record id="notification_mobile_template_notification_approval_task" model="notification.mobile.template">
            <field name="name">Approval Mobile Notification</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="title">Approval {{object.name}}</field>
            <field name="body"><![CDATA[Hi {{object.notification_to_user_id.partner_id.name}}, {{object.name}} Vendor butuh approval anda. Terima kasih]]></field>
<!--            <field name="image">Todo send url image</field>-->
            <field name="code">
data['url'] = record.vendor_link
            </field>
        </record>
        <record id="notification_template_approval_task" model="notification.template">
            <field name="name">Notification Vendor Approval Task</field>
            <field name="model">res.partner</field>
            <field name="template_email" ref="cmp_metalindo_vendor_approval.vendor_approval_mail_template" />
            <field name="template_chatter" ref="cmp_metalindo_vendor_approval.mail_template_chat_notification_approval_task" />
            <field name="template_whatsapp" ref="cmp_metalindo_vendor_approval.whatsapp_template_notification_approval_task" />
            <field name="template_mobile" ref="cmp_metalindo_vendor_approval.notification_mobile_template_notification_approval_task" />
        </record>
    </data>
</odoo>
