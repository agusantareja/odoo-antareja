<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit res.config.settings view -->
    <record id="res_config_settings_view_form_inherit" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.cni.api</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="antareja_notification_ceria_mobile_intra.res_config_settings_view_form_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='mobile_notification_remote']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
