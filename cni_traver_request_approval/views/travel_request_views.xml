<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="travel_request_view_form" model="ir.ui.view">
            <field name="name">travel.request.view.form</field>
            <field name="model">travel.request</field>
            <field name="inherit_id" ref="cni_travel_request.travel_request_view_form"/>
            <field name="arch" type="xml">
                <header position="inside">
                    <button name="register_approval_task"
                            string="Register Approval Task"
                            type="object"
                            class="btn-secondary"
                            groups="base.group_no_one"

                    />
                    <button name="unregister_approval_task"
                            string="Register Approval Task"
                            type="object"
                            class="btn-secondary"
                            groups="base.group_no_one"

                    />
                </header>
            </field>
        </record>
    </data>
</odoo>
