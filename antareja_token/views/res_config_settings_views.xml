<odoo>
    <record id="view_config_settings_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="antareja_base.view_config_settings_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='antareja_token_description']" position="after">
                <div class="mt16 row">
                    <label for="antareja_token_issuer" class="col-3 col-lg-3 o_light_label"/>
                    <field name="antareja_token_issuer" nolabel="1"/>
                </div>
                <div class="mt16 row">
                    <label for="antareja_token_secret" class="col-3 col-lg-3 o_light_label"/>
                    <field name="antareja_token_secret" nolabel="1"/>
                </div>
                <div class="mt16 row">
                    <label for="antareja_token_retention_in" class="col-3 col-lg-3 o_light_label"/>
                    <field name="antareja_token_retention_in" nolabel="1"/>
                </div>
                <div class="mt16 row">
                    <label for="antareja_token_expires_in" class="col-3 col-lg-3 o_light_label"/>
                    <field name="antareja_token_expires_in" nolabel="1"/>
                </div>
            </xpath>
            <xpath expr="//div[@id='antareja_token_description']/../../.." position="after">

                <div class="col-xs-12 col-md-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="module_antareja_token_oauth"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <div class="content-group">
                            <label for="module_antareja_token_oauth"/>
                            <div class="text-muted" id="antareja_token_oauth_description">
                                Auth Oauth
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-md-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="module_antareja_token_client"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <div class="content-group">
                            <label for="module_antareja_token_client"/>
                            <div class="text-muted" id="antareja_token_oauth_description">
                                Auth Oauth
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>

        </field>
    </record>
</odoo>
