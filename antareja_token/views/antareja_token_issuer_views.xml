<?xml version="1.0"?>
<odoo>
        <record id="view_antareja_token_issuer_form" model="ir.ui.view">
            <field name="name">antareja.token.issuer.form</field>
            <field name="model">antareja.token.issuer</field>
            <field name="arch" type="xml">
                <form string="arch">
                    <sheet>
                        <group>
                            <field name="name" />
                            <field name="issuer_type" />
<!--                            <field name="enabled" />-->
<!--                            <field name="body" />-->
<!--                            <field name="css_class"/>-->
                        </group>
                        <group>
                            <field name="auth_endpoint" />
<!--                            <field name="scope" />-->
                            <field name="validation_endpoint" />
                            <field name="data_endpoint" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>        
        <record id="view_antareja_token_issuer_tree" model="ir.ui.view">
            <field name="name">antareja.token.issuer.tree</field>
            <field name="model">antareja.token.issuer</field>
            <field name="arch" type="xml">
                <tree string="arch">
                    <field name="name" />
                    <field name="issuer_type" />
<!--                    <field name="enabled" />-->
                </tree>
            </field>
        </record>
        <record id="action_antareja_token_issuer" model="ir.actions.act_window">
            <field name="name">Token Issuer</field>
            <field name="res_model">antareja.token.issuer</field>
            <field name="view_mode">tree,form</field>
        </record>
        <menuitem id="menu_antareja_token_issuers" name="Token Issuer"
            parent="base.menu_users" sequence="30"
            action="action_antareja_token_issuer" groups="base.group_no_one"/>
</odoo>
