<?xml version="1.0"?>
<odoo>
        <record id="view_antareja_token_audience_form" model="ir.ui.view">
            <field name="name">antareja.token.audience.form</field>
            <field name="model">antareja.token.audience</field>
            <field name="arch" type="xml">
                <form string="arch">
                    <sheet>
                        <group>
                            <field name="name" />
                        </group>
                        <group>
                            <field name="issuer_ids" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>        
        <record id="view_antareja_token_audience_tree" model="ir.ui.view">
            <field name="name">antareja.token.audience.tree</field>
            <field name="model">antareja.token.audience</field>
            <field name="arch" type="xml">
                <tree string="arch">
                    <field name="name" />
                    <field name="issuer_ids" />
                </tree>
            </field>
        </record>
        <record id="action_antareja_token_audience" model="ir.actions.act_window">
            <field name="name">Token Audience</field>
            <field name="res_model">antareja.token.audience</field>
            <field name="view_mode">tree,form</field>
        </record>
        <menuitem id="menu_antareja_token_audiences" name="Token Audience"
            parent="base.menu_users" sequence="30"
            action="action_antareja_token_audience" groups="base.group_no_one"/>
</odoo>
