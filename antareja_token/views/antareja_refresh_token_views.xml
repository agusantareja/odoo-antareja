<?xml version="1.0"?>
<odoo>
        <record id="view_antareja_refresh_token_form" model="ir.ui.view">
            <field name="name">antareja.refresh.token.form</field>
            <field name="model">antareja.refresh.token</field>
            <field name="arch" type="xml">
                <form string="arch">
                    <sheet>
                        <group>
                            <field name="token" />
                            <field name="user_id" />
                        </group>
                        <group>
                            <field name="expires_at" />
                            <field name="revoked" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>        
        <record id="view_antareja_refresh_token_tree" model="ir.ui.view">
            <field name="name">antareja.refresh.token.tree</field>
            <field name="model">antareja.refresh.token</field>
            <field name="arch" type="xml">
                <tree string="arch">
                    <field name="token" />
                    <field name="user_id" />
                    <field name="expires_at" />
                    <field name="revoked" />
                </tree>
            </field>
        </record>
        <record id="action_antareja_refresh_token" model="ir.actions.act_window">
            <field name="name">Refresh Token</field>
            <field name="res_model">antareja.refresh.token</field>
            <field name="view_mode">tree,form</field>
        </record>
        <menuitem id="menu_antareja_refresh_tokens" name="Token Issuer"
            parent="base.menu_users" sequence="30"
            action="action_antareja_refresh_token" groups="base.group_no_one"/>
</odoo>
