<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="internal.data.event.config" id="internal_data_event_config">
        <field name="model_id" ref="antareja_doa.model_user_delegation"/>
        <field name="fields_include">active,name,state</field>
        <field name="filter_expr">record.state in ['prepared','active','cancelled','expired']</field>
        <field name="log_create" eval="False"/>
        <field name="log_write" eval="True"/>
        <field name="log_unlink" eval="True"/>
        <field name="sudo_read" eval="True"/>
    </record>
</odoo>
