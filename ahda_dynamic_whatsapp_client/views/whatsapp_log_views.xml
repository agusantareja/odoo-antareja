<odoo>
    <!-- Log Tree View -->
    <record id="view_whatsapp_log_tree" model="ir.ui.view">
        <field name="name">whatsapp.log.tree</field>
        <field name="model">whatsapp.log</field>
        <field name="arch" type="xml">
            <tree decoration-success="status == 'sent'" decoration-danger="status == 'failed'" decoration-muted="status == 'pending'">
                <field name="create_date"/>
                <field name="payload" widget="text" options="{'max_length': 50}"/>
                <field name="status"/>
            </tree>
        </field>
    </record>

    <!-- Log Form View -->
    <record id="view_whatsapp_log_form" model="ir.ui.view">
        <field name="name">whatsapp.log.form</field>
        <field name="model">whatsapp.log</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="api_id"/>
                            <field name="record_ref"/>
                            <field name="recipient_partner_id"/>
                        </group>
                        <group>
                            <field name="status"/>
                            <field name="failure_reason" attrs="{'invisible': [('status', '!=', 'failed')]}"/>
                            <field name="create_date" string="Timestamp"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="API Details">
                             <group>
                                <field name="payload"/>
                                <field name="response_text"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="action_whatsapp_log_all" model="ir.actions.act_window">
        <field name="name">WhatsApp Logs</field>
        <field name="res_model">whatsapp.log</field>
        <field name="view_mode">tree,form</field>
    </record>
    
</odoo>
