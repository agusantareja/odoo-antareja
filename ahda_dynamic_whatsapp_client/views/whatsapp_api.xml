<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- List View -->
        <record model="ir.ui.view" id="whatsapp_api_tree">
            <field name="name">whatsapp.api.tree</field>
            <field name="model">whatsapp.api</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="endpoint"/>
                </tree>
            </field>
        </record>
        

        <!-- Form View -->
        <record model="ir.ui.view" id="whatsapp_api_form">
            <field name="name">whatsapp.api.form</field>
            <field name="model">whatsapp.api</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_open_logs" type="object" class="oe_stat_button" icon="fa-list">
                                <field name="log_count" widget="statinfo" string="Logs"/>
                            </button>
                        </div>
                        <group>
                            <label for="name"/>
                            <div>
                                <field name="name"/>
                            </div>

                            <label for="endpoint"/>
                            <div>
                                <field name="endpoint"/>
                                <div class="form-text text-muted" style="margin-top:8px">
                                    Full URL endpoint that will receive POST requests. Example:
                                    <code>https://graph.facebook.com/v17.0/&lt;phone_number_id&gt;/messages</code>
                                </div>
                            </div>

                            <label for="header"/>
                            <div>
                                <field name="header"/>
                                <div class="form-text text-muted" style="margin-top:8px">
                                    HTTP headers in Python dict format (parsed with <code>ast.literal_eval</code>). Example:
                                    <code>{'Authorization': 'Bearer YOUR_TOKEN', 'Content-Type': 'application/json'}</code>
                                </div>
                            </div>

                            <label for="param_ids"/>
                            <div>
                                <field name="param_ids">
                                    <tree editable="bottom">
                                        <field name="name"/>
                                    </tree>
                                </field>
                                <div class="form-text text-muted" style="margin-top:8px">
                                    Define the parameter keys your API expects in the JSON payload. Each row's <b>Name</b> becomes a key in the payload.
                                    When a WhatsApp Template selects this API, its body parameters are auto-generated from this list.
                                </div>
                            </div>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>



        <record model="ir.actions.act_window" id="whatsapp_api_action">
            <field name="name">Whatsapp API</field>
            <field name="res_model">whatsapp.api</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>