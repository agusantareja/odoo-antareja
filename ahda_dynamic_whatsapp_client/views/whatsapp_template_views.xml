<odoo>
    <record id="view_whatsapp_template_tree" model="ir.ui.view">
        <field name="name">whatsapp.template.tree</field>
        <field name="model">whatsapp.template</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="model_id"/>
            </tree>
        </field>
    </record>

    <record id="view_whatsapp_template_form" model="ir.ui.view">
        <field name="name">whatsapp.template.form</field>
        <field name="model">whatsapp.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="whatsapp_api_id"/>
                        <field name="model_id"/>
                        <label for="recipient"/>
                        <div>
                            <field name="recipient"/>
                            <field name="recipient_info" class="form-text text-muted" readonly="1" nolabel="1"/>
                        </div>
                        <label for="body_param_ids"/>
                        <div>
                            <field name="body_param_ids">
                                <tree create="0" delete="0" editable="bottom">
                                    <field name="key" readonly="1" force_save="1"/>
                                    <field name="type"/>
                                    <field name="value"/>
                                </tree>
                            </field>
                            <field name="body_param_info" class="form-text text-muted" readonly="1" nolabel="1"/>
                        </div>
                   </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_whatsapp_template" model="ir.actions.act_window">
        <field name="name">WhatsApp Template</field>
        <field name="res_model">whatsapp.template</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
