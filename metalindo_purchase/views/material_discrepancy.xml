<odoo>
  <data>
    <record model="ir.ui.view" id="material_discrepancy_tree">
      <field name="name">material.discrepancy.tree</field>
      <field name="model">purchase.order</field>
      <field name="priority" eval="50"/>
      <field name="arch" type="xml">
        <tree string="Material Discrepancy" create="0" edit="0" delete="0">
            <field name="priority" optional="show" widget="priority" nolabel="1"/>
            <field name="partner_ref" optional="hide"/>
            <field name="name" string="Purchase Order"  decoration-bf="1" decoration-info="state in ('draft','sent')"/>
            <field name="partner_id"/>
            <field name="company_id" options="{'no_create': True}" optional="show"/>
            <field name="user_id" widget="many2one_avatar_user" optional="show"/>
            <field name="date_order" optional="show"/>
            <field name="origin" optional="show"/>
            <field name="amount_untaxed" sum="Total Untaxed amount" string="Untaxed" widget="monetary" optional="hide"/>
            <field name="amount_total" sum="Total amount" widget="monetary" optional="show" decoration-bf="1"/>
            <field name="currency_id" invisible="1"/>
            <field name="state" invisible="1"/>
            <field name="invoice_status" widget="badge" decoration-success="invoice_status == 'invoiced'" decoration-info="invoice_status == 'to invoice'" optional="show"/>
            <field name="date_planned" invisible="context.get('quotation_only', False)" optional="show"/>
        </tree>
      </field>
    </record>

    <record model="ir.ui.view" id="material_discrepancy_form">
      <field name="name">material.discrepancy.form</field>
      <field name="model">purchase.order</field>
      <field name="priority" eval="50"/>
      <field name="arch" type="xml">
        <form string="Discrepancy" create="0" edit="1" delete="0">
        <sheet>
                <div class="oe_title">
                    <span class="o_form_label">Purchase Order </span>
                    <h1 class="d-flex">
                        <field name="name" readonly="1"/>
                    </h1>
                </div>
          <group>
            <group>
                <field name="partner_id" readonly="1"/>
                <field name="partner_ref" readonly="1"/>
                <field name="requisition_id" readonly="1" attrs="{'invisible': [('requisition_id', '=', False)]}"/>
                <field name="currency_id" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <field name="state" invisible="1"/>
                <field name="discrepancy_status"/>
            </group>
            <group>
                <field name="date_order" readonly="1"/>
                <field name="date_approve" readonly="1"/>
                <field name="date_planned" readonly="1"/>
                <field name="effective_date" readonly="1"/>
            </group>
          </group>
          <button name="button_backorder" type="object" string="Backorder" class="oe_highlight"/>
          <field name="discrepancy_ids" readonly="0">
            <tree string="MDR" create="0" edit="1" delete="0" editable="false">
                <field name="product_id" readonly="1"/>
                <field name="qty_order" readonly="1"/>
                <field name="qty_receive" readonly="1"/>
                <field name="product_uom_category_id" invisible="1" />
                <field name="product_uom" string="UoM" readonly="1"/>
                <field name="receiving_discrepancy_note" readonly="1"/>
                <field name="backorder_status"/>
                <field name="discrepancy_note"/>
            </tree>
            <form string="MDR" create="0" edit="1" delete="0">
                <group>
                  <field name="purchase_id" readonly="1"/>
                  <field name="product_id" readonly="1"/>
                  <field name="qty_order" readonly="1"/>
                  <field name="qty_receive" readonly="1"/>
                  <field name="product_uom_category_id" invisible="1" />
                  <field name="product_uom" string="UoM" readonly="1"/>
                  <field name="backorder_status"/>
                  <field name="discrepancy_note"/>
                </group>
                <!-- <field name="move_ids" readonly="1">
                  <tree>
                    <field name="company_id" invisible="1"/>
                    <field name="product_uom_category_id" invisible="1"/>
                    <field name="picking_id" />
                    <field name="date" />
                    <field name="product_uom_qty" string="Qty Order" attrs="{'invisible': [('state', 'in', ('done', 'cancel'))]}"/>
                    <field name="quantity_done" string="Qty Receive" attrs="{'invisible': [('state', '!=', 'done')]}"/>
                    <field name="product_uom" string="UoM"/>
                    <field name="state" />
                    <field name="discrepancy_note"/>
                  </tree>
                </field> -->
            </form>
          </field>
        </sheet>
          <div class="oe_chatter">
              <field name="message_follower_ids"/>
              <field name="activity_ids"/>
              <field name="message_ids"/>
          </div>
        </form>
      </field>
    </record>

    <record id="material_discrepancy_search" model="ir.ui.view">
      <field name="name">material.discrepancy.search</field>
      <field name="model">purchase.order</field>
      <field name="priority" eval="50"/>
      <field name="arch" type="xml">
        <search string="Search MDR">
          <field name="name" string="Order"
              filter_domain="['|', '|', ('name', 'ilike', self), ('partner_ref', 'ilike', self)]"/>
          <field name="partner_id" operator="child_of"/>
          <field name="user_id"/>
          <field name="product_id"/>
          <filter name="my_purchases" string="My Purchases" domain="[('user_id', '=', uid)]"/>
          <filter name="mdr_open" string="MDR Open" domain="[('discrepancy_status', '=', 'open')]"/>
          <filter name="mdr_close" string="MDR Close" domain="[('discrepancy_status', '=', 'close')]"/>
        </search>
      </field>
    </record>

    <record id="material_discrepancy_action" model="ir.actions.act_window">
      <field name="name">Material Discrepancy Report (MDR)</field>
      <field name="type">ir.actions.act_window</field>
      <field name="res_model">purchase.order</field>
      <field name="view_mode">tree,form</field>
      <field name="search_view_id" ref="material_discrepancy_search"/>
      <field name="view_ids" eval="[(5, 0, 0),
        (0, 0, {'view_mode': 'tree', 'view_id': ref('material_discrepancy_tree')}),
        (0, 0, {'view_mode': 'form', 'view_id': ref('material_discrepancy_form')})]"/>
      <field name="domain">[('discrepancy_status', '!=', False)]</field>
      <field name="context">{'search_default_mdr_open':1}</field>
    </record>
  </data>
</odoo>
