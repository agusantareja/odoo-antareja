<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
    	<record id="metalindo_account_move_form" model="ir.ui.view">
            <field name="name">metalindo.account.move.form</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='ref']" position="attributes">
                    <attribute name="required">1</attribute>
                </xpath>
                <xpath expr="//field[@name='payment_reference']" position="attributes">
                    <attribute name="attrs">{'invisible': [('move_type', 'not in', ('out_invoice', 'out_refund', 'in_refund', 'out_receipt', 'in_receipt'))]}</attribute>
                </xpath>
                <xpath expr="//field[@name='ref'][1]" position="attributes">
                    <attribute name="attrs">{'invisible':[('move_type', 'not in', ('in_invoice', 'in_receipt', 'in_refund'))], 'readonly': [('state', '!=', 'draft')]}</attribute>
                </xpath>
                <xpath expr="//field[@name='ref'][2]" position="attributes">
                    <attribute name="attrs">{'invisible':[('move_type', 'in', ('in_invoice', 'in_receipt', 'in_refund', 'out_invoice', 'out_refund'))], 'readonly': [('state', '!=', 'draft')]}</attribute>
                </xpath>
                <xpath expr="//field[@name='invoice_line_ids']/tree//field[@name='account_id']" position="after">
                    <field name="purchase_category_id" options="{'no_create': True, 'no_edit': True}"
                        attrs="{'column_invisible': [('parent.move_type', '!=', 'in_invoice')]}" optional="show"/>
                    <field name="hs_code" optional="show"
                        attrs="{'column_invisible': [('parent.move_type', '!=', 'in_invoice')]}"/>
                </xpath>
                <xpath expr="//field[@name='invoice_line_ids']/form//field[@name='account_id']" position="after">
                    <field name="purchase_category_id" options="{'no_create': True, 'no_edit': True}"
                        attrs="{'invisible': [('parent.move_type', '!=', 'in_invoice')]}"
                        domain="[('urutan', '=', 0)]"/>
                    <field name="hs_code" attrs="{'invisible': [('parent.move_type', '!=', 'in_invoice')]}"/>
                </xpath>
                <!-- Jika tidak ditambah di line_ids maka field purchase_category_id tak bisa menyimpan isian -->
                <xpath expr="//field[@name='line_ids']/tree//field[@name='account_id']" position="after">
                    <field name="purchase_category_id" invisible="1"/>
                    <field name="hs_code" invisible="1"/>
                </xpath>
                <xpath expr="//field[@name='line_ids']/form//field[@name='account_id']" position="after">
                    <field name="purchase_category_id" invisible="1"/>
                    <field name="hs_code" invisible="1"/>
                </xpath>

            </field>
        </record>
    </data>
</odoo>
