<odoo>
    <data>
        <!--BRO BUYER ASSIGNMENT-->
        <record id="bro_buyer_assignment_search" model="ir.ui.view">
            <field name="name">bro.buyer.assignment.search</field>
            <field name="priority">50</field>
            <field name="model">recommend.qty</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name" />
                    <field name="product_id"/>
                    <separator />
                    <filter string="Unassigned" name="unassigned"
                        domain="[('procurement_user_id','=', False), ('state','in',['Ready to Purchase', 'Assignment'])]" />
                    <filter string="Assigned" name="assigned" domain="[('procurement_user_id', '!=', False)]"/>
                </search>
            </field>
        </record>

        <record id="bro_buyer_assignment_tree" model="ir.ui.view">
            <field name="name">bro.buyer.assignment.tree</field>
            <field name="model">recommend.qty</field>
            <field name="arch" type="xml">
                <tree default_order="product_criticality_id asc">
                    <header>
                        <button string="Assign Buyer" name="action_assign_buyer" type="object" class="oe_highlight"/>
                    </header>
                    <field name="name" readonly="1" />
                    <field name="recommend_date" readonly="1" />
                    <field name="product_desc" string="Product" readonly="1" />
                    <field name="part_number"/>
                    <field name="company_id" readonly="1" />
                    <field name="note" widget="text" readonly="1" />
                    <field name="product_criticality_id" readonly="1"/>
                    <field name="purchase_qty" readonly="1" />
                    <field name="bro_purchase_qty" readonly="1"></field>
                    <field name="qty_available" string="On Hand" readonly="1" optional="hide"/>
                    <field name="reserved_qty" invisible="1" />
                    <field name="product_min_qty" string="ROP" readonly="1" optional="hide"/>
                    <field name="product_max_qty" string="ROQ" readonly="1" optional="hide"/>
                    <field name="procurement_user_id" readonly="1"/>
                    <field name="procurement_ref" readonly="1" />
                    <field name="state" readonly="1" />
                    <field name="qty_done" readonly="1" invisible="1"/>
                    <button title="Show" name="show_procurement" type="object" attrs="{'invisible':[('procurement_ref','=',False)]}" class="fa fa-external-link"/>
                </tree>
            </field>
        </record>

        <record id="bro_buyer_assignment_action" model="ir.actions.act_window">
            <field name="name">BRO Assignment Buyer</field>
            <field name="res_model">recommend.qty</field>
            <field name="view_mode">tree</field>
            <field name="domain">[('purchase_qty','>',0),('state','!=','Draft')]</field>
            <field name="search_view_id" ref="bro_buyer_assignment_search" />
            <field name="view_id" ref="bro_buyer_assignment_tree" />
            <field name="context">{'search_default_unassigned':1, 'delete': 0, 'create': 0, 'bro': 1}</field>
        </record>


        <!--Buyer Ready to Purchase-->
        <record id="report_recommended_quantity_purchase_search" model="ir.ui.view">
            <field name="name">report.recommended.quantity.purchase.search</field>
            <field name="model">recommend.qty</field>
            <field name="priority">10</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name" />
                    <field name="product_id"/>
                    <separator />
                    <filter string="Ready to Purchase" name="ready_to_purchase" domain="[('state', '=', 'Ready to Purchase')]"/>
                    <separator/>
                    <filter string="My Assignment" name="my_assignment" domain="[('procurement_user_id', '=', uid)]"/>
                </search>
            </field>
        </record>

        <record id="report_recommended_quantity_purchase_tree" model="ir.ui.view">
            <field name="name">report.recommended.quantity.purchase.tree</field>
            <field name="model">recommend.qty</field>
            <field name="arch" type="xml">
                <tree create="0" editable="bottom" default_order="product_criticality_id asc">
                    <header>
                        <button name="action_create_procurement_recommend_qty" string="Create Procurement" class="oe_highlight" type="object" groups="metalindo_inventory.group_metalindo_procurement_engineer"/>
                    </header>
                    <field name="name" readonly="1" />
                    <field name="recommend_date" readonly="1" />
                    <field name="product_desc" string="Product" readonly="1" />
                    <field name="part_number"/>
                    <field name="company_id" readonly="1" />
                    <field name="note" widget="text" readonly="1" />
                    <field name="product_criticality_id" readonly="1"/>
                    <field name="purchase_qty" readonly="1" />
                    <field name="bro_purchase_qty" attrs="{'readonly': [('state', 'not in', ('Assignment','Ready to Purchase'))]}"></field>
                    <field name="purchase_order_qty" readonly="1" optional="hide"/>
                    <field name="real_purchase_order_qty" readonly="1" invisible="1" groups="base.group_no_one"/>
                    <field name="outstanding_qty" readonly="1" optional="show"/>
                    <field name="qty_available" string="On Hand" readonly="1" optional="hide"/>
                    <field name="reserved_qty" invisible="1" />
                    <field name="product_min_qty" string="ROP" readonly="1" optional="hide"/>
                    <field name="product_max_qty" string="ROQ" readonly="1" optional="hide"/>
                    <field name="procurement_user_id" readonly="1"/>
                    <field name="procurement_ref" readonly="1" />
                    <field name="state" readonly="1" />
                    <field name="qty_done" readonly="1" invisible="1"/>
                    <field name="purchase_ids" widget="many2many_tags" readonly="1" optional="hide"/>
                    <button string="Show" name="show_procurement" type="object" attrs="{'invisible':[('procurement_ref','=',False)]}" groups="purchase.group_purchase_manager" />
                </tree>
            </field>
        </record>

        <record id="buyer_report_recommended_quantity_purchase_action" model="ir.actions.act_window">
            <field name="name">BRO Ready to Purchase</field>
            <field name="res_model">recommend.qty</field>
            <field name="view_mode">tree</field>
            <field name="domain">[('purchase_qty', '>', 0), ('state','!=','Draft')]</field>
            <field name="search_view_id" ref="report_recommended_quantity_purchase_search" />
            <field name="view_id" ref="report_recommended_quantity_purchase_tree" />
            <field name="context">{'search_default_ready_to_purchase':1, 'search_default_my_assignment':1, 'copy': 0, 'delete': 0, 'bro': 1}</field>
        </record>

        <!--SRO INVENTORY-->
        <record id="report_recommended_quantity_inventory_search" model="ir.ui.view">
            <field name="name">report.recommended.quantity.tree</field>
            <field name="model">recommend.qty</field>
            <field name="priority">100</field>
            <field name="arch" type="xml">
                <search string="Reordering Calculation">
                    <field name="product_id" />
                    <field name="company_id" />
                    <separator />
                    <filter string="Waiting Inventory Approval" name="draft" domain="[('state','=','Draft')]" />
                    <filter string="Ready to Purchase" name="to_purchase" domain="[('state','=','Ready to Purchase')]" />
                </search>
            </field>
        </record>

        <record id="report_recommended_quantity_inventory_tree" model="ir.ui.view">
            <field name="name">report.recommended.quantity.tree</field>
            <field name="model">recommend.qty</field>
            <field name="arch" type="xml">
                <tree create="0" default_order="recommend_qty desc" editable="bottom">
                    <field name="recommend_date" readonly="1" />
                    <field name="product_desc" string="Product" readonly="1" />
                    <field name="part_number"/>
                    <field name="company_id" readonly="1" />
                    <field name="note" widget="text" attrs="{'readonly':[('state','!=','Draft')]}" />
                    <field name="recommend_qty" string="System Recommended Qty" readonly="1" />
                    <field name="purchase_qty" attrs="{'readonly':[('state','!=','Draft')]}" />
                    <field name="qty_available" string="On Hand" readonly="1" optional="hide"/>
                    <field name="reserved_qty" invisible="1" />
                    <field name="product_min_qty" string="ROP" widget="integer" readonly="1" optional="hide"/>
                    <field name="product_max_qty" string="ROQ" widget="integer" readonly="1" optional="hide"/>
                    <field name="bro_qty" readonly="1" optional="hide"/>
                    <field name="bro_ref_number" readonly="1" optional="hide"/>
                    <field name="po_qty" readonly="1" optional="hide"/>
                    <field name="po_ref_number" readonly="1" optional="hide"/>
                    <field name="state" readonly="1" />
                    <field name="qty_done" readonly="1" invisible="1"/>
                    <button attrs="{'invisible':[('state','!=','Draft')]}" name="approve_to_purchase" string="Approve" type="object" groups="metalindo_inventory.group_inventory_control" confirm="Are you sure for approve this SRO ?"/>
                </tree>
            </field>
        </record>

        <record id="report_recommended_quantity_inventory_action" model="ir.actions.act_window">
            <field name="name">Store Recommended Order</field>
            <field name="res_model">recommend.qty</field>
            <field name="view_mode">tree</field>
            <field name="domain">[('recommend_qty','>',0), ('state', '=', 'Draft')]</field>
            <field name="context">{'sro': 1}</field>
            <field name="search_view_id" ref="report_recommended_quantity_inventory_search" />
            <field name="view_id" ref="report_recommended_quantity_inventory_tree" />
        </record>

        <record id="recomended_quantity_inventory_view_tree" model="ir.ui.view">
            <field name="name">recomended.qty.inventory.view.tree</field>
            <field name="model">recommend.qty</field>
            <field name="arch" type="xml">
                <tree create="0" default_order="recommend_qty desc" editable="bottom">
                    <field name="name" readonly="1" />
                    <field name="recommend_date" readonly="1" />
                    <field name="product_desc" string="Product" readonly="1" />
                    <field name="part_number"/>
                    <field name="company_id" readonly="1" />
                    <field name="note" widget="text" readonly="1" />
                    <field name="purchase_qty" />
                    <field name="bro_purchase_qty" />
                    <field name="qty_available" string="On Hand" readonly="1" optional="hide"/>
                    <field name="reserved_qty" invisible="1" />
                    <field name="product_min_qty" string="ROP" optional="hide"/>
                    <field name="product_max_qty" string="ROQ" optional="hide"/>
                    <field name="procurement_user_id" readonly="1"/>
                    <field name="procurement_ref" readonly="1" />
                    <field name="state" readonly="1" />
                    <field name="qty_done" readonly="1" invisible="1"/>
                </tree>
            </field>
        </record>

        <record id="report_buy_recommended_quantity_inventory_action" model="ir.actions.act_window">
            <field name="name">Buy Recommended Order</field>
            <field name="res_model">recommend.qty</field>
            <field name="view_mode">tree</field>
            <field name="domain">[('purchase_qty','>',0),('state','!=','Draft')]</field>
            <field name="search_view_id" ref="report_recommended_quantity_inventory_search" />
            <field name="view_id" ref="recomended_quantity_inventory_view_tree" />
            <field name="context">{'edit': 0, 'bro': 1}</field>
        </record>

        <record id="sro_report_view_tree" model="ir.ui.view">
            <field name="name">sro.report.view.tree</field>
            <field name="model">recommend.qty</field>
            <field name="priority">1000</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name" string="RO Number"/>
                    <field name="create_date" widget="date" string="SRO Date"/>
                    <field name="stock_code"/>
                    <field name="material_short_description"/>
                    <field name="material_long_description"/>
                    <field name="manufacturer_id"/>
                    <field name="part_number"/>
                    <field name="uom_id"/>
                    <field name="sro_qty"/>
                    <field name="approval_user_id"/>
                    <field name="po_date" widget="date"/>
                    <field name="purchase_id" string="PO Number"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <record id="sro_report_search" model="ir.ui.view">
            <field name="name">sro.report.search</field>
            <field name="model">recommend.qty</field>
            <field name="priority">1000</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name" />
                    <field name="product_id" />
                    <separator />
                    <filter string="Outstanding" name="outstanding" domain="[('state','!=','Done')]" />
                </search>
            </field>
        </record>

        <record id="action_sro_report" model="ir.actions.act_window">
            <field name="name">SRO Report</field>
            <field name="res_model">recommend.qty</field>
            <field name="view_mode">tree</field>
            <field name="domain">[('state', '!=', False), ('purchase_qty','>',0)]</field>
            <field name="search_view_id" ref="sro_report_search" />
            <field name="view_id" ref="sro_report_view_tree" />
            <field name="context">{'search_default_outstanding': 1, 'create': 0, 'edit':0, 'delete': 0, 'copy':0}</field>
        </record>
    </data>
</odoo>

