<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="view_product_template_purchase_buttons_from_inherit">
            <field name="name">view.product.template.purchase.buttons.from.inherit</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="purchase.view_product_template_purchase_buttons_from"/>
            <field name="arch" type="xml">
                <field name="categ_id" position="after">
                    <field name="purchase_category_id" options="{'no_create': True, 'no_edit': True}"
                        domain="[('urutan', '=', 0)]"/>
                </field>
                <xpath expr="//button[@name='action_view_po']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//button[@name='action_view_po']" position="after">
                    <button class="oe_stat_button"
                        name="action_view_po_incoming"
                        type="object"
                        icon="fa-download">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_value">
                                <field name="po_incoming_qty" widget="statinfo" nolabel="1" class="mr4"/>
                            </span>
                            <span class="o_stat_text">PO Incoming</span>
                        </div>
                    </button>
                    <button type="object"
                        name= "action_view_stock_move"
                        attrs="{'invisible':[('type', 'not in', ['product', 'consu'])]}"
                        class="oe_stat_button" icon="fa-exchange"
                        groups="stock.group_stock_user">
                        <div class="o_field_widget o_stat_info mr4">
                            <span class="o_stat_text">In:</span>
                            <span class="o_stat_text">Out:</span>
                        </div>
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_value"><field name="nbr_moves_in"/></span>
                            <span class="o_stat_value"><field name="nbr_moves_out"/></span>
                        </div>
                    </button>
                </xpath>
            </field>
        </record>

        <record model="ir.ui.view" id="metalindo_product_template_min_max_button_inherit">
            <field name="name">metalindo.product.template.min.max.button.inherit</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="stock.product_template_form_view_procurement_button"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_view_orderpoints']" position="after">
                    <button class="oe_stat_button"
                        name="action_view_sro"
                        type="object"
                        icon="fa-tasks">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_value">
                                <field name="sro_qty" widget="statinfo" nolabel="1" class="mr4"/>
                            </span>
                            <span class="o_stat_text">SRO</span>
                        </div>
                    </button>
                    <button class="oe_stat_button"
                        name="action_view_bro"
                        type="object"
                        icon="fa-shopping-cart">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_value">
                                <field name="bro_qty" widget="statinfo" nolabel="1" class="mr4"/>
                            </span>
                            <span class="o_stat_text">BRO</span>
                        </div>
                    </button>
                </xpath>
            </field>
        </record>
    </data>
</odoo>         
