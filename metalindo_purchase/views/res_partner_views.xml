<odoo>
    <data>
        <record id="delivery_point_form" model="ir.ui.view">
            <field name="name">delivery.point.form</field>
            <field name="model">res.partner</field>
            <field name="priority" eval="99" />
            <field name="arch" type="xml">
                <form string="Delivery Point">
                    <sheet>
                        <group>
                            <group>
                            <field name="name" string="Delivery Point Name" default_focus="1" required="1"/>
                            <!--field name="delivery_point_name" default_focus="1"/-->
                            <!-- <label for="" string="Address" /> -->
                            <span class="o_form_label o_td_label" name="address_name">
                                <b>Address</b>
                            </span>
                            <div class="o_address_format">
                                <field name="street" placeholder="Street..." class="o_address_street" required="1"/>
                                <field name="street2" placeholder="Street 2..." class="o_address_street" />
                                <field name="city" placeholder="City" class="o_address_city" required="1"/>
                                <field name="state_id" class="o_address_state" placeholder="State" options='{"no_open": True}' context="{'country_id': country_id, 'zip': zip}" />
                                <field name="zip" placeholder="ZIP" class="o_address_zip" />
                                <field name="country_id" placeholder="Country" class="o_address_country" options='{"no_open": True, "no_create": True}' />
                            </div>
                            </group>
                            <group>
                                <field name="phone"/>
                                <field name="is_delivery_point" invisible="1" />
                                <field name="picking_type_id" domain="[('code', '=', 'incoming')]"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="delivery_point_tree" model="ir.ui.view">
            <field name="name">delivery.point.tree</field>
            <field name="model">res.partner</field>
            <field name="priority" eval="99" />
            <field name="arch" type="xml">
                <tree>
                    <field name="name" />
                </tree>
            </field>
        </record>

        <record model="ir.actions.act_window" id="delivery_point_action">
            <field name="name">Delivery Point</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">tree,form</field>
            <field name="domain">[('is_delivery_point','=',True)]</field>
            <field name="context">{'default_is_delivery_point':True}</field>
        </record>

        <record model="ir.actions.act_window.view" id="delivery_point_action_form">
            <field name="sequence" eval="2" />
            <field name="view_mode">form</field>
            <field name="view_id" ref="delivery_point_form" />
            <field name="act_window_id" ref="delivery_point_action" />
        </record>

        <record model="ir.actions.act_window.view" id="delivery_point_action_tree">
            <field name="sequence" eval="1" />
            <field name="view_mode">tree</field>
            <field name="view_id" ref="delivery_point_tree" />
            <field name="act_window_id" ref="delivery_point_action" />
        </record>

        <!-- <act_window id="partner_wizard_action"
        name="Grant portal access"
        binding_model="res.partner"
        res_model="portal.wizard"
        view_mode="form" target="new"
        groups="base.group_partner_manager"/> -->

        <record model="ir.ui.view" id="metalindo_res_partner_view_purchase_buttons">
            <field name="name">metalindo.res.partner.view.purchase.buttons</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="purchase.res_partner_view_purchase_buttons"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='%(purchase.act_res_partner_2_purchase_order)d']" position="before">
                    <field name="supplier_rank" invisible="1"/>
                </xpath>
                <xpath expr="//button[@name='%(purchase.act_res_partner_2_purchase_order)d']" position="attributes">
                    <attribute name="attrs">{'invisible': [('supplier_rank', '=', 0)]}</attribute>
                </xpath>
            </field>
        </record>

        <record model="ir.ui.view" id="metalindo_res_partner_view_purchase_account_buttons_inherit">
            <field name="name">metalindo.res.partner.view.purchase.account.buttons.inherit</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="purchase.res_partner_view_purchase_account_buttons"/>
            <field name="arch" type="xml">
                 <xpath expr="//button[@name='%(purchase.act_res_partner_2_supplier_invoices)d']" position="before">
                    <field name="supplier_rank" invisible="1"/>
                </xpath>
                <xpath expr="//button[@name='%(purchase.act_res_partner_2_supplier_invoices)d']" position="attributes">
                    <attribute name="attrs">{'invisible': [('supplier_rank', '=', 0)]}</attribute>
                </xpath>
            </field>
        </record>

        <record model="ir.ui.view" id="metalindo_res_partner_view_purchase_buttons_inherit">
            <field name="name">metalindo.res.partner.view.purchase.buttons.inherit</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="purchase_stock.res_partner_view_purchase_buttons_inherit"/>
            <field name="arch" type="xml">
                 <xpath expr="//button[@name='%(purchase_stock.action_purchase_vendor_delay_report)d']" position="before">
                    <field name="supplier_rank" invisible="1"/>
                </xpath>
                <xpath expr="//button[@name='%(purchase_stock.action_purchase_vendor_delay_report)d']" position="attributes">
                    <attribute name="attrs">{'invisible': [('supplier_rank', '=', 0)]}</attribute>
                </xpath>
            </field>
        </record>

        <!-- <record model="ir.ui.view" id="metalindo_view_partner_form_inherit">
            <field name="name">metalindo.vendor.view_partner_form.inherit</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form">
                <xpath expr="//page[@name='sales_purchases']" position="attributes">
                    <attribute name="attrs">{'invisible': [('supplier_rank', '=', 0)]}</attribute>
                </xpath>
            </field>
        </record> -->
    </data>
</odoo>
