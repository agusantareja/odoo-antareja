    <!-- The <report> tag is deprecated, use a <record> tag
    <report string="New Purchase Order" id="metalindo_action_report_purchase_order_slip" model="purchase.order" report_type="qweb-pdf" name="metalindo_purchase.metalindo_purchase_order_slip" file="metalindo_purchase.purchase_order_slip" print_report_name="'Purchase Order - %s - %s' % (object.partner_id.name or '', object.name)" />
    -->

    <record id="purchase_incoming_tree" model="ir.ui.view">
        <field name="name">purchase.incoming.tree</field>
        <field name="model">purchase.order.line</field>
        <field name="priority">99999</field>
        <field name="arch" type="xml">
            <tree create="false" default_order="order_id asc">
                <field name="order_id" widget="many2one"/>
                <field name="date_approve" widget="date"/>
                <field name="partner_id"/>
                <field name="product_qty"/>
                <field name="qty_received"/>
                <field name="po_incoming_qty"/>
                <field name="price_unit"/>
            </tree>
        </field>
    </record>

     <record id="action_purchase_incoming" model="ir.actions.act_window">
        <field name="res_model">purchase.order.line</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="metalindo_purchase.purchase_incoming_tree"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No purchase order incoming were made for this product yet!
            </p>
        </field>
    </record>
    <!-- The <report> tag is deprecated, use a <record> tag
    <report string="Vendor Acknowledge" id="metalindo_action_report_vendor_acknowledge" model="purchase.order" report_type="qweb-pdf" name="metalindo_purchase.metalindo_purchase_vendor_acknowledge" file="metalindo_purchase.vendor_acknowledge" print_report_name="'Vendor Acknowledge - %s - %s' % (object.partner_id.name or '', object.name)" />
    -->

</odoo>
