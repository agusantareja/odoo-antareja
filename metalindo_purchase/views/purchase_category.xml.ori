<odoo>
  <data>
    <record model="ir.ui.view" id="purchase_category_tree">
      <field name="name">purchase.category.tree</field>
      <field name="model">purchase.category</field>
      <field name="arch" type="xml">
        <tree editable="bottom" default_order="name">
          <field name="name"/>
        </tree>
      </field>
    </record>

    <record model="ir.ui.view" id="purchase_category_form">
      <field name="name">purchase.category.form</field>
      <field name="model">purchase.category</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <group>
              <field name="name"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <record model="ir.ui.view" id="purchase_plan_year_tree">
      <field name="name">purchase.plan.year.tree</field>
      <field name="model">purchase.plan.year</field>
      <field name="arch" type="xml">
        <tree default_order="name">
          <field name="name" string="Tahun"/>
          <field name="company_id" groups="base.group_multi_company"/>
        </tree>
      </field>
    </record>

    <record model="ir.ui.view" id="purchase_plan_year_form">
      <field name="name">purchase.plan.year.form</field>
      <field name="model">purchase.plan.year</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <h2><center>Rencana Belanja Tahun <field name="name" required="1" style="margin-right:10px;"/>
                <field name="company_id" required="1"/></center></h2>
            <field name="plan_ids" widget="one2many" mode="tree,form"
              context="{'default_year_id': id}" attrs="{'invisible': [('id', '=', False)]}">
              <tree default_order="urutan, category_id" editable="top">
                <field name="urutan" invisible="1"/>
                <field name="category_id" options="{'no_create': True, 'no_edit': True}" required="1"
                  domain="[('urutan', '=', 0)]" attrs="{'readonly': [('urutan', '!=', 0)]}"/>
                <field name="year_id" required="1" string="Tahun"
                  attrs="{'readonly': [('urutan', '!=', 0)]}"/>
                <field name="usd_id" invisible="1"/>
                <field name="idr_id" invisible="1"/>
                <field name="impor_usd" widget="monetary" options="{'currency_field': 'usd_id'}"
                  attrs="{'invisible': [('urutan', '!=', 0)]}"/>
                <field name="domestik_idr" widget="monetary" options="{'currency_field': 'idr_id'}"
                  attrs="{'invisible': [('urutan', '!=', 0)]}"/>
                <field name="belanja_tkdn" widget="monetary" options="{'currency_field': 'idr_id'}"
                  attrs="{'invisible': [('urutan', '!=', 0)]}"/>
              </tree>
              <form>
                <group>
                  <group>
                    <field name="urutan" invisible="1"/>
                    <field name="category_id" options="{'no_create': True, 'no_edit': True}" required="1"
                      domain="[('urutan', '=', 0)]"/>
                    <field name="year_id" required="1" string="Tahun"/>
                  </group>
                  <group>
                    <field name="usd_id" invisible="1"/>
                    <field name="idr_id" invisible="1"/>
                    <field name="impor_usd" widget="monetary" options="{'currency_field': 'usd_id'}"
                      attrs="{'invisible': [('urutan', '!=', 0)]}"/>
                    <field name="domestik_idr" widget="monetary" options="{'currency_field': 'idr_id'}"
                      attrs="{'invisible': [('urutan', '!=', 0)]}"/>
                    <field name="belanja_tkdn" widget="monetary" options="{'currency_field': 'idr_id'}"
                      attrs="{'invisible': [('urutan', '!=', 0)]}"/>
                    <field name="sum_impor_usd" attrs="{'invisible': [('urutan', 'in', (0,3))]}"/>
                    <field name="sum_domestik_idr" attrs="{'invisible': [('urutan', 'in', (0,3))]}"/>
                    <field name="sum_belanja_tkdn" attrs="{'invisible': [('urutan', 'in', (0,3))]}"/>
                  </group>
                </group>
              </form>
            </field>
            <field name="usd_id" invisible="1"/>
            <field name="idr_id" invisible="1"/>

            <h3>Total</h3>
            <div class="row">
              <div class="col-4">
                <label for="sum_impor_usd" string="Impor (USD)"/>
                <field name="sum_impor_usd" widget="monetary" options="{'currency_field': 'usd_id'}"/>
              </div>
              <div class="col-4">
                <label for="sum_impor_usd" string="Domestik (IDR)"/>
                <field name="sum_domestik_idr" widget="monetary" options="{'currency_field': 'idr_id'}"/>
              </div>
              <div class="col-4">
                <label for="sum_belanja_tkdn" string="Belanja TKDN (IDR)"/>
                <field name="sum_belanja_tkdn" widget="monetary" options="{'currency_field': 'idr_id'}"/>
              </div>
            </div>

            <div class="row">
              <div class="col-4">
                <label for="persen_sum_impor_usd" string="Persentase Impor (%)"/>
                <field name="persen_sum_impor_usd" widget="percentage"/>
              </div>
              <div class="col-4">
                <label for="persen_sum_domestik_idr" string="Persentase Domestik (%)"/>
                <field name="persen_sum_domestik_idr" widget="percentage"/>
              </div>
              <div class="col-4">
                <label for="persen_sum_belanja_tkdn" string="Persentase Belanja TKDN (%)"/>
                <field name="persen_sum_belanja_tkdn" widget="percentage"/>
              </div>
            </div>
          </sheet>
        </form>
      </field>
    </record>

    <record model="ir.ui.view" id="realisasi_belanja_year_form">
      <field name="name">realisasi.belanja.year.form</field>
      <field name="model">purchase.plan.year</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <h2><center>Realisasi Belanja Tahun <field name="name" style="margin-right:10px;"/>
                <field name="company_id"/></center></h2>
            <field name="plan_ids" widget="one2many" mode="tree,form" string="Realisasi Belanja"/>
            <field name="usd_id" invisible="1"/>
            <field name="idr_id" invisible="1"/>

            <h3>Total</h3>
            <div class="row">
              <div class="col-4">
                <label for="sum_impor_usd" string="Impor (USD)"/>
                <field name="sum_impor_usd" widget="monetary" options="{'currency_field': 'usd_id'}"/>
              </div>
              <div class="col-4">
                <label for="sum_impor_usd" string="Domestik (IDR)"/>
                <field name="sum_domestik_idr" widget="monetary" options="{'currency_field': 'idr_id'}"/>
              </div>
              <div class="col-4">
                <label for="sum_belanja_tkdn" string="Belanja TKDN (IDR)"/>
                <field name="sum_belanja_tkdn" widget="monetary" options="{'currency_field': 'idr_id'}"/>
              </div>
            </div>

            <div class="row">
              <div class="col-4">
                <label for="persen_sum_impor_usd" string="Persentase Impor (%)"/>
                <field name="persen_sum_impor_usd" widget="percentage"/>
              </div>
              <div class="col-4">
                <label for="persen_sum_domestik_idr" string="Persentase Domestik (%)"/>
                <field name="persen_sum_domestik_idr" widget="percentage"/>
              </div>
              <div class="col-4">
                <label for="persen_sum_belanja_tkdn" string="Persentase Belanja TKDN (%)"/>
                <field name="persen_sum_belanja_tkdn" widget="percentage"/>
              </div>
            </div>

            <div class="row">
              <div class="col-4">
                <label for="real_impor_usd" string="Realisasi Impor (USD)"/>
                <field name="real_impor_usd" widget="monetary" options="{'currency_field': 'usd_id'}"/>
              </div>
              <div class="col-4">
                <label for="real_domestik_idr" string="Realisasi Domestik (IDR)"/>
                <field name="real_domestik_idr" widget="monetary" options="{'currency_field': 'idr_id'}"/>
              </div>
              <div class="col-4">
                <label for="real_belanja_tkdn" string="Realisasi Belanja TKDN (IDR)"/>
                <field name="real_belanja_tkdn" widget="monetary" options="{'currency_field': 'idr_id'}"/>
              </div>
            </div>

            <div class="row">
              <div class="col-4">
                <label for="persen_real_impor_usd" string="Persentase Realisasi Impor (%)"/>
                <field name="persen_real_impor_usd" widget="percentage"/>
              </div>
              <div class="col-4">
                <label for="persen_real_domestik_idr" string="Persentase Realisasi Domestik (%)"/>
                <field name="persen_real_domestik_idr" widget="percentage"/>
              </div>
              <div class="col-4">
                <label for="persen_real_belanja_tkdn" string="Persentase Realisasi Belanja TKDN (%)"/>
                <field name="persen_real_belanja_tkdn" widget="percentage"/>
              </div>
            </div>

            <div class="row">
              <div class="col-4">
                <label for="capaian_real_impor_usd" string="Capaian Realisasi Impor (%)"/>
                <field name="capaian_real_impor_usd" widget="percentage"/>
              </div>
              <div class="col-4">
                <label for="capaian_real_domestik_idr" string="Capaian Realisasi Domestik (%)"/>
                <field name="capaian_real_domestik_idr" widget="percentage"/>
              </div>
              <div class="col-4">
                <label for="capaian_real_belanja_tkdn" string="Capaian Realisasi Belanja TKDN (%)"/>
                <field name="capaian_real_belanja_tkdn" widget="percentage"/>
              </div>
            </div>
          </sheet>
        </form>
      </field>
    </record>
<!--
    <record model="ir.ui.view" id="purchase_plan_tree">
      <field name="name">purchase.plan.tree</field>
      <field name="model">purchase.plan</field>
      <field name="arch" type="xml">
      -->
      <!-- Diberi button "Create All Categories" di header menggunakan asset_backend: tree_button.js dan tree_button.xml -->
      <!--
        <tree default_order="tahun, urutan, category_id" editable="top" js_class="button_in_tree">
