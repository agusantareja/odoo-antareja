                <field name="domestik_idr" string="Domestik (IDR)" 
                  widget="monetary" options="{'currency_field': 'idr_id'}"/>
                <field name="belanja_tkdn" string="Belanja TKDN (IDR)"
                  widget="monetary" options="{'currency_field': 'idr_id'}"/>
              </group>
              <group>
                <field name="real_impor_usd" readonly="1" widget="monetary" options="{'currency_field': 'usd_id'}"/>
