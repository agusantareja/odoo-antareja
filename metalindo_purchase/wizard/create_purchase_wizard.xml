<odoo>
    <data>
        <record id="reordering_rule_create_purchase" model="ir.ui.view">
            <field name="name">reordering.rule.create.purchase.form</field>
            <field name="model">create.purchase.wizard</field>
            <field name="arch" type="xml">
                <form string="Create Purchase">
                    <center>
                        <field name="procurement_type" widget="radio" nolabel="1" options="{'horizontal':true}" />
                    </center>
                    <footer>
                        <button name="action_create_purchase" string="Create" type="object" class="btn-primary" />
                    </footer>
                </form>
            </field>
        </record>

        <record id="act_create_purchase_orderpoint" model="ir.actions.act_window">
            <field name="name">Create Procurement</field>
            <field name="res_model">create.purchase.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="binding_model_id" ref="model_stock_warehouse_orderpoint" />
        </record>

        <record id="blanket_order_confirm_form" model="ir.ui.view">
            <field name="name">blanket.order.confirm.form</field>
            <field name="model">blanket.order.confirm.wizard</field>
            <field name="arch" type="xml">
                <form string="Blanket Order">
                    <field name="info" />
                    <footer>
                        <button name="create_purchase" string="Process" type="object" class="btn-primary" />
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>