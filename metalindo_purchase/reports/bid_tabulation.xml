<odoo>

    <!-- <record id="purchase_stock.report_purchaseorder_document" model="ir.ui.view">
        <field name="active" eval="False" />
    </record> -->
    
    <!-- The <report> tag is deprecated, use a <record> tag
    <report id="bid_tabulation_report_id" model="purchase.requisition" string="Bid Tabulation" report_type="qweb-html" name="metalindo_purchase.bid_tabulation" file="metalindo_purchase.bid_tabulation" />
    -->
    <record id="bid_tabulation_report_id" model="ir.actions.report">
        <field name="name">Bid Tabulation</field>
        <field name="model">purchase.requisition</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">metalindo_purchase.bid_tabulation</field>
        <field name="report_file">metalindo_purchase.bid_tabulation</field>
        <field name="binding_model_id" ref="model_purchase_requisition"/>
    </record>

    <record id="bid_tabulation_paperformat_id" model="report.paperformat">
        <field name="name">Bid Tabulation Paper Format</field>
        <field name="default" eval="True" />
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">20</field>
        <field name="dpi">120</field>
    </record>

    <record id="metalindo_purchase.bid_tabulation_report_id" model="ir.actions.report">
        <field name="paperformat_id" ref="bid_tabulation_paperformat_id" />
    </record>

    <template id="bid_tabulation">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <style>
                      
                      .table_black td{
                      border:2px solid #c8c8c8;
                      padding: 2px 4px 2px 4px;
                      color : #666666;
                      }
                      .table_black th{
                      border:2px solid #c8c8c8;
                      text-align:center;
                      padding: 2px 4px 2px 4px;
                      color : #666666;
        
            
                    </style>
                <center>
                    <b>
                        <h2 style="color : #666666">BID TABULATION</h2>
                    </b>
                </center>
                <t t-value="o.get_vendor_ids()" t-set="vendors" />
                <t t-value="o.purchase_ids" t-set="purchase_ids" />
                <table class="table_black" width="100%">
                    <thead>
                        <tr>
                            <th colspan="5" style="text-align:right;background-color:#875A7B;color:white;border-color:#875A7B" />
                            <t t-foreach="purchase_ids" t-as="purchase_id">
                                <t t-value="'#eea920' if purchase_id == o.cheapest_purchase_id else '#875A7B'" t-set="vendor_color" />
                                <th colspan="2" class="vendor_row" t-att-style="'background-color:%s;color:white;border-color:%s'%(vendor_color,vendor_color)">
                                    <span t-esc="purchase_id.partner_id.name" />
                                    <br />
                                </th>
                            </t>
                        </tr>
                        <tr>
                            <th colspan="5" style="text-align:right;background-color:#875A7B;color:white;border-color:#875A7B" />
                            <t t-foreach="purchase_ids" t-as="purchase_id">
                                <t t-value="'#eea920' if purchase_id == o.cheapest_purchase_id else '#875A7B'" t-set="vendor_color" />
                                <th colspan="2" class="vendor_row" t-att-style="'background-color:%s;color:white;border-color:%s'%(vendor_color,vendor_color)">
                                    <a t-att-href="purchase_id.get_quotation_link()" target="_blank">
                                        <span t-esc="purchase_id.name" />
                                    </a>
                                </th>
                            </t>
                        </tr>
                        <tr>
                            <th colspan="5" style="text-align:right">
                                    Delivery
                                    </th>
                            <t t-foreach="purchase_ids" t-as="purchase_id">
                                <th colspan="2">
                                    <span t-if="purchase_id.delivery_days" t-esc="'%s Days'%purchase_id.delivery_days" />
                                </th>
                            </t>
                        </tr>
                        <tr>
                            <th colspan="5" style="text-align:right">
                                        Payment Terms
                                        </th>
                            <t t-foreach="purchase_ids" t-as="purchase_id">
                                <th colspan="2">
                                    <span t-field="purchase_id.payment_term_id" />
                                </th>
                            </t>
                        </tr>
                        <tr>
                            <th rowspan="1">Item</th>
                            <th rowspan="1">Product</th>
                            <th rowspan="1">Description</th>
                            <th rowspan="1">Qty</th>
                            <th rowspan="1">UoM</th>
                            <t t-foreach="purchase_ids" t-as="purchase_id">
                                <th>Price</th>
                                <th>Total</th>
                            </t>
                        </tr>
                    </thead>
                    <!-- <t t-value="o.get_vendor_prices()" t-set="prices" /> -->
                    <t t-value="o.get_purchase_prices()" t-set="prices" />
                    <tbody>
                        <t t-value="1" t-set="no" />
                        <t t-foreach="o.line_ids" t-as="line">
                            <tr>
                                <td align="center">
                                    <span t-esc="no" />
                                </td>
                                <td>
                                    <span t-esc="line.product_id.display_name" />
                                </td>
                                <td>
                                    <span t-esc="line.product_desc or line.product_id.description" />
                                </td>
                                <td align="center">
                                    <span t-field="line.product_qty" />
                                </td>
                                <td align="center">
                                    <span t-field="line.product_uom_id" />
                                </td>
                                <t t-foreach="purchase_ids" t-as="purchase_id">
                                    <!-- <t t-value="'%s-%s'%(line.product_id.id,line.product_desc) if o.is_directcharge else line.product_id.id" t-set="product_key"/> -->
                                    <!-- <t t-value="prices.get(vendor.id,{}).get(product_key,False)" t-set="price_unit" /> -->
                                    <t t-value="line.product_id.id" t-set="product_key"/>
                                    <t t-value="prices.get(purchase_id.id,{}).get(product_key,False)" t-set="price_unit" />
                                    <td align="right">
                                        <span t-if="price_unit" t-esc="price_unit['price']" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: price_unit['currency_id']}" />
                                    </td>
                                    <td align="right">
                                        <span t-if="price_unit" t-esc="price_unit['price']*line.product_qty" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: price_unit['currency_id']}" />
                                    </td>
                                </t>
                            </tr>
                            <t t-value="no+1" t-set="no" />
                        </t>
                    </tbody>
                </table>
            </t>
        </t>

    </template>
</odoo>
