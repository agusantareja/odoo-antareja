<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="vendor_code_umkm" model="vendor.code">
            <field name="name">UMKM</field>
            <field name="code">UMKM</field>
            <field name="company_id" eval="False"/>
        </record>

        <function name="write" model="vendor.code">
            <function name="search" model="vendor.code">
                <value eval="[('code', 'in', ('SW', 'SM', 'SQ', 'UMKM'))]"/>
            </function>
            <value eval="{'impor_domestik': 'domestik'}"/>
        </function>

        <function name="write" model="vendor.code">
            <function name="search" model="vendor.code">
                <value eval="[('code', 'in', ('SC', 'SA', 'SE'))]"/>
            </function>
            <value eval="{'impor_domestik': 'impor'}"/>
        </function>

    </data>
</odoo>
