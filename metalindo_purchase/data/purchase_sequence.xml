<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Tidak bisa, karena noupdate=True di XML ID
        <record id="purchase.seq_purchase_order" model="ir.sequence">
           <field name="prefix">Q</field>
        </record> -->
        <!-- <function name="write" model="ir.sequence">
            <function name="search" model="ir.sequence">
                <value eval="[('code', '=', 'purchase.order')]"/>
            </function>
            <value eval="{'prefix': 'Q'}"/>
        </function> -->
        <function name="write" model="ir.sequence">
            <function name="search" model="ir.sequence">
                <value eval="[('code', '=', 'purchase.requisition.blanket.order')]"/>
            </function>
            <value eval="{'prefix': 'B'}"/>
        </function>
    </data>

    <data noupdate="1">
        <record id="call_for_tender" model="purchase.requisition.type">
            <field name="name">Call for Tender</field>
            <field name="sequence">1</field>
            <field name="exclusive">exclusive</field>
            <field name="quantity_copy">copy</field>
            <field name="line_copy">copy</field>
        </record>
        <record id="seq_tender" model="ir.sequence">
            <field name="name">Call for Tender</field>
            <field name="code">purchase.requisition.tender</field>
            <field name="prefix">T</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"></field>
        </record>
        <record id="seq_recommend_qty" model="ir.sequence">
            <field name="name">Sequence Recommend Qty</field>
            <field name="code">recommend.qty</field>
            <field name="prefix">RO</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"></field>
        </record>
        <record id="sequence_purchase_rfq" model="ir.sequence">
            <field name="name">Purchase RFQ</field>
            <field name="code">purchase.rfq</field>
            <field name="prefix">CMP-Q-%(month)s%(y)s-</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"></field>
        </record>
    </data>
</odoo>
