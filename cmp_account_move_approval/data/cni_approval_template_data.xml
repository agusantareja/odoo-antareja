<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="cni_approval_template" model="cni.approval.template">
<!--            <field name="is_primary" eval="True"/>-->
            <field name="model_id" ref="model_account_move"/>
            <field name="state_field">approval_state</field>
            <field name="state_waiting_approvals">waiting_approval</field>
            <field name="state_reject">draft</field>
            <field name="state_approved">approved</field>
<!--            <field name="view_name">vendor approval</field>-->
            <field name="config_sts">1,3</field>
<!--            <field name="notification_approval_id" ref="cmp_metalindo_vendor_approval.notification_template_approval_task"/>-->
            <field name="code">
response['transaction_approval_matrix']=transaction_object.journal_id.approval_matrix_id
response['transaction_requester']= transaction_object.user_id.id or transaction_object.activity_user_id.id or transaction_object.create_uid.id or user
