<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_report_generate_store_tree" model="ir.ui.view">
        <field name="name">report.generate.store.tree</field>
        <field name="model">report.generate.store</field>
        <field name="arch" type="xml">
            <tree string="Report Generate Store"
                  default_order="create_date desc"
                  decoration-success="state == 'done'"
                  decoration-danger="state == 'error'"
                  decoration-warning="state == 'processing'"
            >
                <field name="name"/>
                <field name="user_id"/>
                <field name="state"/>
                <field name="executor"/>
                <field name="last_call"/>
                <field name="next_call"/>
            </tree>
        </field>
    </record>

    <record id="view_report_generate_store_form" model="ir.ui.view">
        <field name="name">report.generate.store.form</field>
        <field name="model">report.generate.store</field>
        <field name="arch" type="xml">
            <form string="Report Generate Store">
                <header>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="prepare,processing,done,error"/>
                    <!-- Optional action button -->
                    <button name="generate_report"
                            type="object"
                            string="Generate"
                            class="btn-primary"
                             />
<!--                    <button name="action_retry"-->
<!--                            type="object"-->
<!--                            string="Retry"-->
<!--                            class="btn-primary"-->
<!--                            attrs="{'invisible': [('state', '!=', 'error')]}"/>-->
                </header>

                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="user_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="report_attachment_id" options="{'no_create': True}" readonly="1"/>
                        </group>
                    </group>
                    <notebook groups="base.group_no_one">
                        <page string="Error"
                              attrs="{'invisible': [('state', '!=', 'error')]}">
                            <group>
                                <field name="error_message" readonly="1"/>
                                <field name="error_trace" readonly="1"/>
                            </group>
                        </page>
                        <page string="Config"  >
                            <group>
                                <field name="last_call" readonly="1"/>
                                <field name="next_call" readonly="1"/>
                                <field name="executor" readonly="1"/>
                            </group>
                        </page>
                        <page string="Parameter"  >
                            <field name="parameter_json" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_report_generate_store" model="ir.actions.act_window">
        <field name="name">Report Generator</field>
        <field name="res_model">report.generate.store</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_report_generate_store_root"
              name="Reports"
              sequence="10"/>

    <menuitem id="menu_report_generate_store"
              name="Generated Report Store"
              parent="menu_report_generate_store_root"
              action="action_report_generate_store"
              sequence="10"/>
</odoo>
