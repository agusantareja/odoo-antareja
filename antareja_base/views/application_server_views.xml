<odoo>
    <!-- Tree View -->
    <record id="view_application_server_search" model="ir.ui.view">
        <field name="name">application.server</field>
        <field name="model">application.server</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="view_application_server_tree" model="ir.ui.view">
        <field name="name">application.server.tree</field>
        <field name="model">application.server</field>
        <field name="arch" type="xml">
            <tree string="Application Server">
                <field name="name" string="Name"/>
                <field name="description"/>
                <field name="endpoint"/>
            </tree>
        </field>
    </record>

    <record id="view_application_server_form" model="ir.ui.view">
        <field name="name">application.server.form</field>
        <field name="model">application.server</field>
        <field name="arch" type="xml">
            <form string="Application Server">
                <header>
                    <field name="active" invisible="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name . . ."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="endpoint" string="Endpoint" attrs="{'invisible':[('config_param_name','in',['',False])]}"/>
                            <field name="endpoint_value" string="Endpoint" attrs="{'invisible':[('config_param_name','not in',['',False])]}"/>
                        </group>
                        <group>
                            <field name="config_param_name"/>
                            <button string="Edit" type="object" name="open_config_parameter" attrs="{'invisible':[('config_param_name','in',['',False])]}"/>
                        </group>
                    </group>
                    <notebook >
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Auth Methods">
                            <field name="application_server_auth_ids" context="{'edit_from_server_form':True}">
                                <tree>
                                    <field name="application_server_id" invisible="1" />
                                    <field name="name" string="Name"/>
                                    <field name="auth_type"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                    <footer/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_application_server" model="ir.actions.act_window">
        <field name="name">Application Server</field>
        <field name="res_model">application.server</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_application_server_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Application Server here.
            </p>
        </field>
    </record>

</odoo>
