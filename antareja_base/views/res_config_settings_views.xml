<odoo>
    <record id="view_config_settings_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.wa</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="approval_notif" id="antareja_base_addons" string="Approval Notif"
                     data-key="antareja_base_addons" groups="base.group_erp_manager">
                    <div id="antareja_base">
                        <h2>Application</h2>
                        <div class="row mt16 o_settings_container">
                            <div class="col-xs-12 col-md-6 o_setting_box" >
                                <div class="o_setting_right_pane" >
                                    <div class="content-group">
                                        <div class="mt16 row">
                                            <label for="antareja_application_name" string="Application" class="col-3 col-lg-3 o_light_label"/>
                                            <field name="antareja_application_name" nolabel="1"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xs-12 col-md-6 o_setting_box" >
                                <div class="o_setting_left_pane">
                                    <field name="module_antareja_integration"/>
                                </div>
                                <div class="o_setting_right_pane">
                                    <div class="content-group">
                                        <label for="module_antareja_integration"/>
                                        <div class="text-muted">
                                            Application Integration
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div id="antareja_notification">
                        <h2>Notification</h2>
                        <div class="row mt16 o_settings_container">
                            <div class="col-xs-12 col-md-6 o_setting_box" >
                                <div class="o_setting_left_pane">
                                    <field name="module_antareja_notification"/>
                                </div>
                                <div class="o_setting_right_pane" >
                                    <div class="content-group">
                                        <label for="module_antareja_notification"/>
                                        <div class="text-muted">
                                            Notification
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xs-12 col-md-6 o_setting_box" >
                                <div class="o_setting_left_pane">
                                    <field name="module_antareja_notification_whatsapp"/>
                                </div>
                                <div class="o_setting_right_pane">
                                    <div class="content-group">
                                        <label for="module_antareja_notification_whatsapp"/>
                                        <div class="text-muted">
                                            Notification Whatsapp
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-xs-12 col-md-6 o_setting_box" >
                                <div class="o_setting_left_pane">
                                    <field name="module_antareja_whatsapp_migration"/>
                                </div>
                                <div class="o_setting_right_pane">
                                    <div class="content-group">
                                        <label for="module_antareja_whatsapp_migration"/>
                                        <div class="text-muted">
                                            Whatsapp Migration
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div id="antareja_doa" groups="base.group_erp_manager">
                        <h2>DoA</h2>
                        <div class="row mt16 o_settings_container">
                            <div class="col-xs-12 col-md-6 o_setting_box" id="antareja_doa_enabled_setting">
                                <div class="o_setting_left_pane">
                                    <field name="module_antareja_doa"/>
                                </div>
                                <div class="o_setting_right_pane">
                                    <div class="content-group">
                                        <label for="module_antareja_doa"/>
                                        <div class="text-muted">
                                            Delegation of Authority (DoA)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div id="antareja_mobile_token">
                        <h2>Mobile Token</h2>
                        <div class="row mt16 o_settings_container">
                            <div class="col-xs-12 col-md-6 o_setting_box" >
                                <div class="o_setting_left_pane">
                                    <field name="module_antareja_mobile_token"/>
                                </div>
                                <div class="o_setting_right_pane">
                                    <div class="content-group">
                                        <label for="module_antareja_mobile_token"/>
                                        <div class="text-muted" id="antareja_mobile_token_description">
                                            Mobile Token Auth
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div id="antareja_notification_mobile_client">
                        <h2>Mobile Notification Client</h2>
                        <div class="row mt16 o_settings_container">
                            <div class="col-xs-12 col-md-6 o_setting_box" id="module_antareja_notification_ceria_mobile_intra" >
                                <div class="o_setting_left_pane">
                                    <field name="module_antareja_notification_ceria_mobile_intra"/>
                                </div>
                                <div class="o_setting_right_pane">
                                    <div class="content-group">
                                        <label for="module_antareja_notification_ceria_mobile_intra"/>
                                        <div class="text-muted" >
                                            Approval and Notification interagation to Ceria Mobile
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
