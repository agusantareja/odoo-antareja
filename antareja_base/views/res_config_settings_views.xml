<odoo>
    <record id="view_config_settings_form_wa" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.wa</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@class='settings']//div[@id='emails']" position="after">
                <div id="antareja_base">
                    <h2>Approval and Notification Addons</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-xs-12 col-md-6 o_setting_box" >
                            <div class="o_setting_left_pane">
                                <field name="module_antareja_notification"/>
                            </div>
                            <div class="o_setting_right_pane" >
                                <div class="content-group">
                                    <label for="module_antareja_notification"/>
                                    <div class="text-muted">
                                        Notification
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-md-6 o_setting_box" >
                            <div class="o_setting_left_pane">
                                <field name="module_antareja_notification_ceria_mobile_intra"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <div class="content-group">
                                    <label for="module_antareja_notification_ceria_mobile_intra"/>
                                    <div class="text-muted">
                                        Notification Ceria Mobile
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-md-6 o_setting_box" >
                            <div class="o_setting_left_pane">
                                <field name="module_antareja_notification_whatsapp"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <div class="content-group">
                                    <label for="module_antareja_notification_whatsapp"/>
                                    <div class="text-muted">
                                        Notification Whatsapp
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-md-6 o_setting_box" >
                            <div class="o_setting_left_pane">
                                <field name="module_antareja_whatsapp_migration"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <div class="content-group">
                                    <label for="module_antareja_whatsapp_migration"/>
                                    <div class="text-muted">
                                        Whatsapp Migration
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-xs-12 col-md-6 o_setting_box" >
                            <div class="o_setting_left_pane">
                                <field name="module_antareja_doa"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <div class="content-group">
                                    <label for="module_antareja_doa"/>
                                    <div class="text-muted">
                                        Delegation of Authority (DoA)
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-12 col-md-6 o_setting_box" >
                            <div class="o_setting_left_pane">
                                <field name="module_ceria_mobile_notification"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <div class="content-group">
                                    <label for="module_ceria_mobile_notification"/>
                                    <div class="text-muted">
                                        Ceria Mobile Mobile Notification and Approval Server
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-xs-12 col-md-6 o_setting_box" >
                            <div class="o_setting_left_pane">
                                <field name="module_ceria_mobile_notification_test"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <div class="content-group">
                                    <label for="module_ceria_mobile_notification_test"/>
                                    <div class="text-muted">
                                        Ceria Mobile Firebase Test Config
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
