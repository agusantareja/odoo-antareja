<odoo>

    <record id="view_api_call_retry_search" model="ir.ui.view">
        <field name="name">api.call.retry.search</field>
        <field name="model">api.call.retry</field>
        <field name="arch" type="xml">
            <search>
                <field name="error_message"/>
                <filter string="Retry" name="retry"
                        domain="[('state', '=', 'retry')]"/>
                <filter string="Error and Done" name="error_done"
                        domain="[('state', 'in', ['error','done'])]"/>
            </search>
        </field>
    </record>

    <record id="view_api_call_retry_tree" model="ir.ui.view">
        <field name="name">api.call.retry.tree</field>
        <field name="model">api.call.retry</field>
        <field name="arch" type="xml">
            <tree>
                <field name="error_message" widget="section_and_note_text"/>
                <field name="res_method"/>
                <field name="last_call"/>
                <field name="state"/>

                <button name="retry" string="Retry" type="object" icon="fa-paper-plane text-success" attrs="{'invisible':[('state','!=','retry')]}" />
                <button name="mark_retry" string="Mark Retry" type="object" icon="fa-repeat text-success" attrs="{'invisible':[('state','not in',['error','done'])]}"/>

                <field name="next_call" optional="hide"/>
                <field name="res_id" optional="hide"/>
                <field name="res_model" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="view_api_call_retry_action" model="ir.actions.act_window">
        <field name="name">Integration Call Retry </field>
        <field name="res_model">api.call.retry</field>
        <field name="view_mode">tree</field>
        <field name="context">{'create': 0,'edit': 0,'delete': 0}</field>
    </record>

</odoo>
