<odoo>
    <!-- Tree View -->
    <record id="view_application_server_auth_tree" model="ir.ui.view">
        <field name="name">application.server.auth.tree</field>
        <field name="model">application.server.auth</field>
        <field name="arch" type="xml">
            <tree string="Application Server">
                <field name="name" string="Name"/>
                <field name="application_server_id"/>
                <field name="auth_type"/>
            </tree>
        </field>
    </record>

    <record id="view_application_server_auth_form" model="ir.ui.view">
        <field name="name">application.server.auth.form</field>
        <field name="model">application.server.auth</field>
        <field name="arch" type="xml">
            <form string="Application Server">
                <header>
                    <field name="active" invisible="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name . . ." />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="auth_type"/>
                        </group>
                        <group>
                            <field name="application_server_id"  readonly="context.get('edit_from_server_form')" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Auth Rest" attrs="{'invisible':[('auth_type','!=','rest-token')]}">
                            <group>
                                <group>
                                    <field name="rest_token_in"/>
                                </group>
                                <group attrs="{'invisible':[('rest_token_in','!=','basic')]}">
                                    <field name="username"/>
                                    <field name="password"/>
                                </group>
                                <group attrs="{'invisible':[('rest_token_in','=','basic')]}">
                                    <field name="rest_token_key"/>
                                    <field name="rest_token"/>
                                </group>
                            </group>
                        </page>
                        <page string="ODOO RCP" attrs="{'invisible':[('auth_type','!=','odoo-rcp')]}" name="page_odoo_rcp">
                            <group>
                                <group>
                                    <field name="odoo_server_db"/>
<!--                                    <button string="Get db name" type="object" name="action_get_odoo_db_name"/>-->
                                    <field name="odoo_server_uid"/>
                                </group>
                                <group>
                                    <field name="username"/>
                                    <field name="password"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_application_server_auth" model="ir.actions.act_window">
        <field name="name">Application Server Auth</field>
        <field name="res_model">application.server.auth</field>
        <field name="view_mode">tree,form</field>

        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Application Server Auth here.
            </p>
        </field>
    </record>

</odoo>
