<odoo>
    <!-- TREE VIEW -->
    <record id="view_approval_strategy_template_instance_tree" model="ir.ui.view">
        <field name="name">approval.strategy.template.instance.tree</field>
        <field name="model">approval.strategy.template.instance</field>
        <field name="arch" type="xml">
            <tree string="Approval Strategy Template Stages" default_order="transaction_model_name, sequence">
                <field name="active"/>
                <field name="sequence"/>
                <field name="name"/>
                <field name="transaction_model_name"/>
            </tree>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_approval_strategy_template_instance_form" model="ir.ui.view">
        <field name="name">approval.strategy.template.instance.form</field>
        <field name="model">approval.strategy.template.instance</field>
        <field name="arch" type="xml">
            <form string="Approval Strategy Template Stage">
                <header>
                    <field name="active" invisible="1"/>

<!--                    <button name="action_try_config"-->
<!--                            string="Try Config"-->
<!--                            type="object"-->
<!--                            class="btn-secondary"/>-->
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="transaction_model_name"/>
                        </group>
                        <group>
                            <field name="draft_status_approval"/>
                            <field name="starting_status_approval"/>
                            <field name="finish_status_approval"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                           <field name="description"/>
                        </page>
                        <page string="Code">
                           <field name="code"/>
                        </page>
                        <page string="Template Stages">
                            <field name="approval_template_stage_ids">
                                <tree>
                                    <field name="sequence" widget="handle"/>
                                    <field name="stage_strategy_name"/>
                                    <field name="stage_strategy_config_model_name" />
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_approval_strategy_template_instance" model="ir.actions.act_window">
        <field name="name">Approval Strategy Template Stages</field>
        <field name="res_model">approval.strategy.template.instance</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your Approval Strategy Template Instance
            </p>
        </field>
    </record>


</odoo>
