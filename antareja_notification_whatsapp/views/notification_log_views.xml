<odoo>
    <data>
        <record id="notification_log_tree" model="ir.ui.view">
            <field name="name">notification.log.tree</field>
            <field name="model">notification.log</field>
            <field name="inherit_id" ref="antareja_notification.notification_log_tree"/>
            <field name="arch" type="xml">
                <tree position="inside">
                    <field name="whatsapp_id" optional="hide"/>
                    <button name="send_whatsapp" string="Send Whatsapp" type="object" class="oe_highlight" attrs="{'invisible':[('whatsapp_id','!=',0)]}"/>
                    <button name="action_show_whatsapp" string="Show Whatsapp" type="object" class="oe_highlight" attrs="{'invisible':[('whatsapp_id','=',0)]}"/>
                </tree>
            </field>
        </record>
    </data>
</odoo>
