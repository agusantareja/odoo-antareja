<odoo>
    <record id="view_config_settings_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.wa</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="antareja_notification.view_config_settings_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='antareja_notification_whatsapp_description']" position="after">
                <div class="mt16 row">
                    <label for="notification_wa_scope" string="Scope"
                           class="col-3 col-lg-3 o_light_label"/>
                    <field name="notification_wa_scope" class="oe_inline"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
