<odoo>

    <!-- TREE VIEW -->

    <record id="view_res_users_passkey_tree"
            model="ir.ui.view">
        <field name="name">res.users.passkey.tree</field>
        <field name="model">res.users.passkey</field>
        <field name="arch" type="xml">

            <tree>
                <field name="jti"/>
                <field name="action"/>
                <field name="status"/>
                <field name="requested_by"/>
                <field name="approved_by"/>
                <field name="expired_at"/>
            </tree>

        </field>

    </record>


    <!-- FORM VIEW -->

    <record id="view_res_users_passkey_form" model="ir.ui.view">
        <field name="name">res.users.passkey.form</field>
        <field name="model">res.users.passkey</field>
        <field name="arch" type="xml">
            <form string="Authentication Challenge">

                <sheet>

                    <!-- STATUS -->

                    <div class="oe_title">

                        <h1>

                            <field name="jti"
                                   readonly="1"/>

                        </h1>

                    </div>

                    <!-- MAIN INFO -->

                    <group>

                        <group>

                            <field name="action"/>

                            <field name="status"
                                   widget="badge"/>

                            <field name="expired_at"/>

                        </group>

                        <group>

                            <field name="requested_by" />

                            <field name="approved_by" />

                        </group>

                    </group>

                    <!-- SECURITY -->

                    <notebook>

                        <page string="Security">

                            <group>

                                <field name="nonce"
                                       readonly="1"
                                       widget="text"/>

                                <field name="sid"
                                       readonly="1"/>

                            </group>

                        </page>

                    </notebook>

                </sheet>

            </form>

        </field>

    </record>


    <!-- SEARCH VIEW -->

    <record id="view_res_users_passkey_search" model="ir.ui.view">
        <field name="name">res.users.passkey.search</field>
        <field name="model">res.users.passkey</field>
        <field name="arch" type="xml">
            <search>
                <field name="jti"/>
                <field name="requested_by"/>
                <field name="approved_by"/>

                <filter string="Pending"
                        name="pending"
                        domain="[('status','=','pending')]"/>

                <filter string="Approved"
                        name="approved" domain="[('status','=','approved')]"/>

                <filter string="Rejected" name="rejected" domain="[('status','=','rejected')]"/>
            </search>
        </field>
    </record>


    <!-- ACTION -->

    <record id="action_res_users_passkey" model="ir.actions.act_window">
        <field name="name">User</field>
        <field name="res_model">res.users.passkey</field>
        <field name="view_mode">tree,form</field>
<!--        <field name="search_view_id" ref="view_res_users_passkey_search"/>-->
    </record>



</odoo>
