<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="whatsapp_template_adr" model="whatsapp.template">
            <field name="name">ADR Approval Notification</field>
            <field name="whatsapp_api_id" ref="cmp_addition_deletion_revision_approval.whatsapp_api_end_point"/>
            <field name="recipient">ctx.get('recipients') or object.notification_to_user_id.partner_id</field>
            <field name="model_id" ref="model_addition_deletion_revision"/>
        </record>

        <record id="whatsapp_template_adr_param_phone" model="whatsapp.template.param">
            <field name="key">phone</field>
            <field name="type">record</field>
            <field name="value">ctx.get('phone')</field>
            <field name="template_id" ref="whatsapp_template_adr"/>
        </record>

        <record id="whatsapp_template_adr_param_message" model="whatsapp.template.param">
            <field name="key">message</field>
            <field name="type">record</field>
            <field name="value">Hai ${partner.name},
ADR berikut membutuhkan persetujuan Anda:

Nomor: ${obj.name}

Mohon periksa pengajuan melalui tautan berikut:

${obj.link}

Terima kasih.

_Pesan ini dikirim secara otomatis oleh sistem ERP CMP._</field>
            <field name="template_id" ref="whatsapp_template_adr"/>
        </record>

        <record id="whatsapp_template_adr_param_ref" model="whatsapp.template.param">
            <field name="key">ref</field>
            <field name="type">record</field>
            <field name="value">${obj.name}</field>
            <field name="template_id" ref="whatsapp_template_adr"/>
        </record>

        <record id="whatsapp_template_adr_param_scope" model="whatsapp.template.param">
            <field name="key">scope</field>
            <field name="type">fix</field>
            <field name="value">ERPCMP</field>
            <field name="template_id" ref="whatsapp_template_adr"/>
        </record>
    </data>
</odoo>
