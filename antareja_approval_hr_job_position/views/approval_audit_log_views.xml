<odoo>
    <record id="view_approval_audit_log_tree" model="ir.ui.view">
        <field name="name">approval.audit.log.tree</field>
        <field name="model">approval.audit.log</field>
        <field name="inherit_id" ref="antareja_base.view_approval_audit_log_tree"/>
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="employee_id" optional="hide"/>
            </field>
            <field name="delegator_id" position="after">
                <field name="delegator_employee_id" optional="hide"/>
            </field>
        </field>
    </record>


</odoo>
