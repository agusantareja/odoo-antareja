<odoo>
    <!-- TREE VIEW -->
    <record id="view_approval_matrix_tiered_rule_tree" model="ir.ui.view">
        <field name="name">approval.matrix.tiered.rule.tree</field>
        <field name="model">approval.matrix.tiered.rule</field>
        <field name="arch" type="xml">
            <tree string="Matrix Tiered" default_order="limit_amount">
                <field name="name"/>
                <field name="model_id"/>
                <field name="scope"/>
                <field name="company_id"/>
                <field name="limit_amount"/>
            </tree>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_approval_matrix_tiered_rule_form" model="ir.ui.view">
        <field name="name">approval.matrix.tiered.rule.form</field>
        <field name="model">approval.matrix.tiered.rule</field>
        <field name="arch" type="xml">
            <form string="Approval Matrix Tiered">
                <header>
                    <field name="active" invisible="1"/>
                    <field name="model"  invisible="1"/>
<!--                    <button name="action_try_config"-->
<!--                            string="Try Config"-->
<!--                            type="object"-->
<!--                            class="btn-secondary"/>-->
                </header>
                <widget name="web_ribbon" title="Archived" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}"/>
                <sheet>
                    <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1><field name="name" class="oe_inline"/></h1>
                        </div>
                    <group>
                        <group>
                            <field name="model_id" options="{'no_create': True}" />
                            <field name="scope"/>
                        </group>
                        <group>
                            <field name="limit_amount"/>
                            <field name="company_id" options="{'no_create': True}" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Tiered Config">
                            <field name="approval_matrix_tiered_rule_line">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="group_ids" widget="many2many_tags"/>
                                    <field name="start_amount"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notification Config">
                            <group>
                                <group>
                                    <field name="notification_template_approval_id" options="{'no_create': True}" />
                                </group>
                                <group>
                                    <field name="notification_template_approved_id" options="{'no_create': True}" />
                                    <field name="notification_template_rejection_id" options="{'no_create': True}"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <footer/>
            </form>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_approval_matrix_tiered_rule" model="ir.actions.act_window">
        <field name="name">Approval Matrix Tiered</field>
        <field name="res_model">approval.matrix.tiered.rule</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your Approval Matrix Tiered
            </p>
        </field>
    </record>

</odoo>
