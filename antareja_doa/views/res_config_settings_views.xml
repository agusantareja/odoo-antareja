<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.microsoft.calendar</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="DoA" id="antareja_doa" string="DoA"
                     data-key="antareja_doa" groups="base.group_erp_manager">
                    <h2>DoA</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box" id="antareja_doa_notif_enabled_setting">
                            <div class="o_setting_left_pane">
                                <field name="module_antareja_doa_notif"/>
                            </div>
                            <div class="o_setting_right_pane" name="antareja_doa_notif_enabled_right_pane">
                                <label for="module_antareja_doa_notif"/>
                                <div class="text-muted">
                                    Enambel DoA Notification
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box" id="antareja_doa_approval_enabled_setting">
                            <div class="o_setting_left_pane">
                                <field name="module_antareja_doa_approval"/>
                            </div>
                            <div class="o_setting_right_pane" name="antareja_doa_approval_enabled_right_pane">
                                <label for="module_antareja_doa_approval"/>
                                <div class="text-muted">
                                    Enambel DoA Approval
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box" id="antareja_doa_server_enabled_setting">
                            <div class="o_setting_left_pane">
                                <field name="module_antareja_doa_server"/>
                            </div>
                            <div class="o_setting_right_pane" name="antareja_doa_server_enabled_right_pane">
                                <label for="module_antareja_doa_server"/>
                                <div class="text-muted">
                                    DoA Server Activate service
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box" id="antareja_doa_client_enabled_setting">
                            <div class="o_setting_left_pane">
                                <field name="module_antareja_doa_client"/>
                            </div>
                            <div class="o_setting_right_pane" name="antareja_doa_client_enabled_right_pane">
                                <label for="module_antareja_doa_client"/>
                                <div class="text-muted">
                                    DoA Client to sync from DoA server
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="antareja_doa_settings_action" model="ir.actions.act_window">
        <field name="name">DoA</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_id" ref="res_config_settings_view_form"/>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'antareja_doa', 'bin_size': False}</field>
    </record>
</odoo>
