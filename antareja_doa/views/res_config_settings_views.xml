<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="antareja_base.view_config_settings_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='antareja_doa_enabled_setting']" position="after">
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="group_doa_internal_user_create"/>
                    </div>
                    <div class="o_setting_right_pane"  >
                        <label for="group_doa_internal_user_create"/>
                        <div class="text-muted">
                            DoA User Create Permission
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-6 o_setting_box" id="antareja_doa_approval_enabled_setting">
                    <div class="o_setting_left_pane">
                        <field name="module_antareja_doa_approval"/>
                    </div>
                    <div class="o_setting_right_pane" name="antareja_doa_approval_enabled_right_pane">
                        <label for="module_antareja_doa_approval"/>
                        <div class="text-muted">
                            DoA Approval
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-6 o_setting_box" id="antareja_integration_doa_enabled_setting">
                    <div class="o_setting_left_pane">
                        <field name="module_antareja_integration_doa"/>
                    </div>
                    <div class="o_setting_right_pane" name="antareja_integration_doa_enabled_right_pane">
                        <label for="module_antareja_integration_doa"/>
                        <div class="text-muted">
                            DoA Intra Integration
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="antareja_doa_settings_action" model="ir.actions.act_window">
        <field name="name">DoA</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_id" ref="res_config_settings_view_form"/>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'antareja_doa', 'bin_size': False}</field>
    </record>
</odoo>
