<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit res.config.settings view -->
    <record id="res_config_settings_view_form_inherit_cni_api" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.cni.api</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="priority">71</field>
        <field name="arch" type="xml">
            <xpath expr="//div[@class='settings']//div[@id='emails']" position="after">
                <div id="ceria_mobile_notification_test">
                    <h2>Ceria Mobile Firebase Test Config </h2>
                    <div class="row mt16 o_settings_container" id="ceria_mobile_notification_test_config">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <div class="content-group">
                                    <div class="mt16 row">
                                        <label for="ceria_mobile_notification_device_test_token" string="Device Test Token" class="col-3 col-lg-3 o_light_label"/>
                                        <field name="ceria_mobile_notification_device_test_token" class="oe_inline" placeholder="Device Test Token"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
