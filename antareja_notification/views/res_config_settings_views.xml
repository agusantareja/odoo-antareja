<odoo>
    <record id="view_config_settings_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.wa</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="antareja_base.view_config_settings_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='antareja_notification']/div" position="inside">
                <div class="col-xs-12 col-md-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="module_antareja_notification_whatsapp"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <div class="content-group">
                            <label for="module_antareja_notification_whatsapp"/>
                            <div class="text-muted" id="antareja_notification_whatsapp_description">
                                Notification Whatsapp
                            </div>
                            <div class="mt16 row">
                                <label for="notification_wa_scope" string="WA Scope Default"
                                       class="col-3 col-lg-3 o_light_label"/>
                                <field name="notification_wa_scope" class="oe_inline"/>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xs-12 col-md-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field name="module_antareja_whatsapp_migration"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <div class="content-group">
                            <label for="module_antareja_whatsapp_migration"/>
                            <div class="text-muted">
                                Whatsapp Migration
                            </div>
                        </div>
                    </div>
                </div>
                <field name="module_auth_admin_sso" invisible="1"/>
                <div class="col-xs-12 col-md-6 o_setting_box"
                     attrs="{'invisible':[('module_auth_admin_sso','=',False)]}">
                    <div class="o_setting_left_pane">
                        <field name="module_antareja_notification_admin_user"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <div class="content-group">
                            <label for="module_antareja_notification_admin_user"/>
                            <div class="text-muted">
                                Ignore Admin User on Notification
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_right_pane">
                        <div class="content-group">
                            <div class="mt16 row">
                                <label for="notification_email_test" string="Test Email Forward"
                                       class="col-3 col-lg-3 o_light_label"/>
                                <field name="notification_email_test" class="oe_inline"/>
                            </div>
                            <div class="mt16 row">
                                <label for="notification_wa_test" string="Test WA No Forward"
                                       class="col-3 col-lg-3 o_light_label"/>
                                <field name="notification_wa_test" class="oe_inline"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
