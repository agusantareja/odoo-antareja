<odoo>
    <!-- FORM VIEW -->
    <record id="view_approval_template_form" model="ir.ui.view">
        <field name="name">approval.template.form</field>
        <field name="model">approval.template</field>
        <field name="inherit_id" ref="antareja_base.view_approval_template_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Template Notification">
                    <group>
                        <group>
                            <field name="notification_approval_id"/>
                        </group>
                        <group>
                            <field name="notification_rejection_id"/>
                            <field name="notification_approved_id"/>
                        </group>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
