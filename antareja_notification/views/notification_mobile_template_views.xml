<odoo>
    <!-- TREE VIEW -->
    <record id="view_notification_mobile_template_tree" model="ir.ui.view">
        <field name="name">notification.mobile.template.tree</field>
        <field name="model">notification.mobile.template</field>
        <field name="arch" type="xml">
            <tree string="Notification Mobile Template" default_order="model_id">
<!--                <field name="active"/>-->
<!--                <field name="sequence"/>-->
                <field name="name"/>
                <field name="model_id"/>
                <field name="model" string="Model Name"/>
            </tree>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_notification_mobile_template_form" model="ir.ui.view">
        <field name="name">notification.mobile.template.form</field>
        <field name="model">notification.mobile.template</field>
        <field name="arch" type="xml">
            <form string="Notification Mobile Template">
                <header>
<!--                    <field name="active" invisible="1"/>-->
<!--                    <button name="action_try_config"-->
<!--                            string="Try Config"-->
<!--                            type="object"-->
<!--                            class="btn-secondary"/>-->
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="model_id"/>
                            <field name="title"/>
                            <field name="body"/>
                            <field name="image"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Python Code" name="code" autofocus="autofocus" >
                            <field name="code" widget="ace" options="{'mode': 'python'}"
                                   placeholder="Enter Python code here. Help about Python expression is available in the help tab of this document."
                            />
                        </page>
                        <page string="Help" name="help_info" autofocus="autofocus" >
                                <div style="margin-top: 4px;">
                                    <h3>Help with Python expressions</h3>
                                    <p>Various fields may use Python code or Python expressions. The following variables can be used:</p>
                                    <ul>
                                        <li><code>env</code>: Odoo Environment on which the action is triggered</li>
                                        <li><code>UserError</code>: Warning Exception to use with <code>raise</code></li>
                                        <li>To return an response, assign: <code> = {...}</code></li>
                                        <li>Bila ingin custom approval line bisa memasukan data ke response['approval_line']</li>
                                    </ul>
                                    <div >
                                        <p>Example of Python code</p>
<code style="white-space: pre-wrap">

</code>
                                    </div>
                                </div>
                            </page>

                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_notification_mobile_template" model="ir.actions.act_window">
        <field name="name">Notification Mobile Template</field>
        <field name="res_model">notification.mobile.template</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your Notification Mobile Template
            </p>
        </field>
    </record>


</odoo>
